#!/bin/bash
# pre-push hook - 本地 CI 门禁
# 安装方法: cp .githooks/pre-push .git/hooks/pre-push

cd "$(git rev-parse --show-toplevel)"

python scripts/git-pre-push-hook.py
exit_code=$?

if [ $exit_code -ne 0 ]; then
    echo ""
    echo "💡 提示：可以使用 --no-verify 跳过 hooks（不推荐）"
    echo "   git push --no-verify"
    exit $exit_code
fi

exit 0
