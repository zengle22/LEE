{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa/test-plan/v1/schema.json",
  "title": "Test Plan",
  "description": "回归测试计划",
  "type": "object",
  "required": ["id", "title", "scope", "cases"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "scope": {"type": "string"},
    "environment": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "priority"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "steps": {"type": "array", "items": {"type": "string"}},
          "expected": {"type": "string"}
        }
      }
    }
  }
}
