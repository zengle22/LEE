{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/testing/bug-contract/v1",
  "title": "Bug Contract",
  "description": "缺陷契约 - 用契约文件管理 Bug 全生命周期，替代传统工单系统",
  "type": "object",
  "required": [
    "bug_id",
    "title",
    "severity",
    "type",
    "status",
    "detected_in",
    "repro",
    "ownership",
    "created_at"
  ],
  "properties": {
    "bug_id": {
      "type": "string",
      "pattern": "^BUG-[0-9]{4}-[0-9]{4}$",
      "description": "缺陷唯一标识 (格式: BUG-YYYY-NNNN)"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "缺陷标题"
    },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "严重级别: P0-阻塞, P1-高, P2-中, P3-低"
    },
    "type": {
      "type": "string",
      "enum": ["functional", "performance", "security", "requirement", "ui", "compatibility"],
      "description": "缺陷类型"
    },
    "status": {
      "type": "string",
      "enum": ["new", "triaged", "diagnosing", "diagnosed", "assigned", "fixing", "fixed", "verified", "closed", "rejected", "deferred"],
      "description": "缺陷状态 (新增 diagnosing/diagnosed/fixing 状态支持 Debug Agent 流程)"
    },
    "detected_in": {
      "type": "object",
      "required": ["version", "environment"],
      "properties": {
        "version": {
          "type": "string",
          "description": "发现版本"
        },
        "commit": {
          "type": "string",
          "description": "发现时的 commit hash"
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "test", "staging", "production"],
          "description": "发现环境"
        },
        "test_case_id": {
          "type": "string",
          "description": "关联的测试用例 ID"
        }
      }
    },
    "repro": {
      "type": "object",
      "required": ["steps", "expected", "actual", "reproducible"],
      "properties": {
        "preconditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "前置条件"
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "复现步骤"
        },
        "expected": {
          "type": "string",
          "description": "期望结果"
        },
        "actual": {
          "type": "string",
          "description": "实际结果"
        },
        "reproducible": {
          "type": "string",
          "enum": ["always", "sometimes", "rarely", "once"],
          "description": "可复现性"
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trace_id": { "type": "string" },
              "service": { "type": "string" },
              "log_snippet": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "screenshots": {
          "type": "array",
          "items": { "type": "string" },
          "description": "截图路径列表"
        },
        "videos": {
          "type": "array",
          "items": { "type": "string" },
          "description": "录屏路径列表"
        },
        "network": {
          "type": "object",
          "properties": {
            "request": { "type": "string" },
            "response": { "type": "string" },
            "status_code": { "type": "integer" }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["core_flow", "secondary_flow", "edge_case", "cosmetic"],
          "description": "影响范围"
        },
        "users_affected": {
          "type": "string",
          "enum": ["all", "most", "some", "few"],
          "description": "受影响用户范围"
        },
        "business_impact": {
          "type": "string",
          "description": "业务影响描述"
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": ["reporter_agent"],
      "properties": {
        "reporter_agent": {
          "type": "string",
          "description": "报告者 Agent ID"
        },
        "owner_agent": {
          "type": "string",
          "description": "负责修复的 Agent ID"
        },
        "reviewer_agent": {
          "type": "string",
          "description": "验证者 Agent ID"
        }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "root_cause": {
          "type": "string",
          "description": "根因分析 (简单描述)"
        },
        "suspected_modules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "疑似问题模块"
        },
        "related_bugs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "相关缺陷 ID"
        }
      }
    },
    "debug_analysis": {
      "type": "object",
      "description": "Debug Agent 深度分析结果",
      "properties": {
        "debug_run_id": {
          "type": "string",
          "description": "关联的调试运行 ID"
        },
        "root_cause": {
          "type": "object",
          "description": "根因详细分析",
          "properties": {
            "summary": {
              "type": "string",
              "description": "根因摘要"
            },
            "category": {
              "type": "string",
              "description": "问题分类",
              "examples": ["database.index_missing", "backend.logic_error", "frontend.render_error"]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "置信度"
            },
            "causal_chain": {
              "type": "array",
              "items": { "type": "string" },
              "description": "因果链"
            },
            "code_locations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": { "type": "string" },
                  "line": { "type": "integer" },
                  "method": { "type": "string" },
                  "issue": { "type": "string" }
                }
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "证据引用路径"
            }
          }
        },
        "fix_plan": {
          "type": "object",
          "description": "修复计划",
          "properties": {
            "recommended": {
              "type": "object",
              "properties": {
                "option": { "type": "string" },
                "description": { "type": "string" },
                "steps": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "patch_ref": { "type": "string" }
              }
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "option": { "type": "string" },
                  "description": { "type": "string" },
                  "recommendation": { "type": "string" }
                }
              }
            },
            "estimated_effort": {
              "type": "string",
              "description": "预估工作量"
            }
          }
        },
        "regression_required": {
          "type": "object",
          "description": "回归测试要求",
          "properties": {
            "scope": {
              "type": "string",
              "enum": ["minimal", "moderate", "extensive"],
              "description": "回归范围"
            },
            "tests": {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "integration": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "e2e": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "checklist_ref": {
              "type": "string",
              "description": "回归检查清单路径"
            }
          }
        },
        "risk_assessment": {
          "type": "object",
          "description": "风险评估",
          "properties": {
            "fix_risk": {
              "type": "string",
              "enum": ["low", "medium", "high"],
              "description": "修复风险"
            },
            "fix_risk_detail": {
              "type": "string",
              "description": "修复风险详情"
            },
            "regression_risk": {
              "type": "string",
              "enum": ["low", "medium", "high"],
              "description": "回归风险"
            },
            "affected_areas": {
              "type": "array",
              "items": { "type": "string" },
              "description": "影响范围"
            }
          }
        },
        "evidence_bundle": {
          "type": "string",
          "description": "证据包目录路径"
        },
        "debug_completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "调试完成时间"
        },
        "debug_agent": {
          "type": "string",
          "description": "执行调试的 Agent ID"
        }
      }
    },
    "fix": {
      "type": "object",
      "properties": {
        "fix_commit": {
          "type": "string",
          "description": "修复 commit hash"
        },
        "fix_version": {
          "type": "string",
          "description": "修复版本"
        },
        "fix_description": {
          "type": "string",
          "description": "修复说明"
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "修复风险评估"
        },
        "fixed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "regression": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "是否需要回归用例"
        },
        "regression_case_id": {
          "type": "string",
          "description": "回归用例 ID"
        },
        "regression_type": {
          "type": "string",
          "enum": ["minimal", "risk", "full"],
          "description": "回归类型"
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "verified_by": {
          "type": "string",
          "description": "验证者 Agent ID"
        },
        "verified_in_version": {
          "type": "string",
          "description": "验证版本"
        },
        "verification_result": {
          "type": "string",
          "enum": ["pass", "fail", "partial"],
          "description": "验证结果"
        },
        "verification_notes": {
          "type": "string",
          "description": "验证备注"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "string",
          "enum": ["fixed", "by_design", "wont_fix", "duplicate", "cannot_reproduce", "deferred"],
          "description": "解决方式"
        },
        "pm_confirmation": {
          "type": "string",
          "enum": ["pending", "confirmed", "rejected"],
          "description": "PM 确认状态 (用于 type=requirement)"
        },
        "decision_reason": {
          "type": "string",
          "description": "决策原因"
        },
        "decided_by": {
          "type": "string",
          "description": "决策者"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "action", "by"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "action": { "type": "string" },
          "by": { "type": "string" },
          "old_value": { "type": "string" },
          "new_value": { "type": "string" }
        }
      },
      "description": "状态变更历史"
    }
  },
  "$defs": {
    "severity_rules": {
      "description": "严重级别定义",
      "P0": "阻塞: 核心功能不可用/崩溃/数据错误/安全问题",
      "P1": "高: 主流程可用但明显错误或影响大量用户",
      "P2": "中: 非主流程问题、体验瑕疵、低频",
      "P3": "低: 文案/样式等"
    },
    "status_transitions": {
      "description": "状态转换规则",
      "new": ["triaged", "rejected"],
      "triaged": ["assigned", "deferred"],
      "assigned": ["fixed", "rejected", "deferred"],
      "fixed": ["verified", "assigned"],
      "verified": ["closed", "assigned"],
      "closed": [],
      "rejected": [],
      "deferred": ["assigned"]
    },
    "permission_matrix": {
      "description": "权限矩阵",
      "qa_agent": {
        "can_update": ["status", "severity", "verification.*"],
        "cannot_update": ["fix.*"]
      },
      "dev_agent": {
        "can_update": ["fix.*", "analysis.*"],
        "cannot_update": ["status", "verification.*"]
      }
    }
  }
}
