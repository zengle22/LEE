{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/specialized-test-contract/v1/schema.json",
    "title": "Specialized Test Contract Schema",
    "description": "Schema for specialized non-functional test cases (performance, security, accessibility)",
    "type": "object",
    "required": [
        "contract_type",
        "contract_version",
        "metadata",
        "performance_test_suites",
        "security_test_suites",
        "accessibility_test_suites"
    ],
    "properties": {
        "contract_type": {
            "type": "string",
            "const": "specialized-test"
        },
        "contract_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "metadata": {
            "type": "object",
            "required": [
                "contract_id",
                "product_name",
                "created_date",
                "status",
                "created_by"
            ],
            "properties": {
                "contract_id": {
                    "type": "string",
                    "pattern": "^STC-\\d{8}-\\d{3}$",
                    "description": "Unique specialized test contract ID (e.g., STC-20260204-001)"
                },
                "product_name": {
                    "type": "string",
                    "description": "Product or feature name being tested"
                },
                "version": {
                    "type": "string",
                    "description": "Test plan version"
                },
                "created_date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 timestamp when test cases were created"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "DRAFT",
                        "READY_FOR_REVIEW",
                        "APPROVED",
                        "DEPRECATED"
                    ],
                    "description": "Current status of the test plan"
                },
                "created_by": {
                    "type": "string",
                    "description": "Agent who created the test cases (agent.qa.specialized_test_agent)"
                },
                "source_architecture": {
                    "type": "string",
                    "description": "Reference to the source technical architecture contract"
                },
                "source_test_cases": {
                    "type": "string",
                    "description": "Reference to the source test case contract for feature mapping"
                },
                "source_ui_contract": {
                    "type": "string",
                    "description": "Reference to the source UI contract (if applicable)"
                }
            }
        },
        "performance_test_suites": {
            "type": "array",
            "description": "Performance test suites covering load, stress, latency, and scalability",
            "items": {
                "type": "object",
                "required": [
                    "suite_id",
                    "name",
                    "type",
                    "priority",
                    "test_cases"
                ],
                "properties": {
                    "suite_id": {
                        "type": "string",
                        "pattern": "^PTS-\\d{3}$",
                        "description": "Performance test suite ID (e.g., PTS-001)"
                    },
                    "name": {
                        "type": "string",
                        "description": "Test suite name"
                    },
                    "description": {
                        "type": "string",
                        "description": "Detailed description of what this suite tests"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "load",
                            "stress",
                            "latency",
                            "scalability",
                            "endurance",
                            "spike"
                        ],
                        "description": "Type of performance testing"
                    },
                    "component": {
                        "type": "string",
                        "description": "Component or system under test"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "P0",
                            "P1",
                            "P2"
                        ],
                        "description": "Priority level"
                    },
                    "test_cases": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "test_id",
                                "title",
                                "scenario",
                                "metrics",
                                "load_model",
                                "steps",
                                "success_criteria"
                            ],
                            "properties": {
                                "test_id": {
                                    "type": "string",
                                    "pattern": "^PTC-\\d{4}$",
                                    "description": "Performance test case ID (e.g., PTC-0001)"
                                },
                                "title": {
                                    "type": "string",
                                    "description": "Short, descriptive title"
                                },
                                "description": {
                                    "type": "string",
                                    "description": "Detailed description of the test case"
                                },
                                "priority": {
                                    "type": "string",
                                    "enum": [
                                        "P0",
                                        "P1",
                                        "P2"
                                    ]
                                },
                                "scenario": {
                                    "type": "string",
                                    "description": "Test scenario description"
                                },
                                "metrics": {
                                    "type": "object",
                                    "description": "Performance metrics to measure",
                                    "properties": {
                                        "response_time": {
                                            "type": "object",
                                            "properties": {
                                                "threshold_ms": {
                                                    "type": "number",
                                                    "description": "Maximum acceptable response time in milliseconds"
                                                },
                                                "percentile": {
                                                    "type": "string",
                                                    "pattern": "^p\\d{2,3}$",
                                                    "description": "Percentile (e.g., p50, p95, p99)"
                                                }
                                            }
                                        },
                                        "throughput": {
                                            "type": "object",
                                            "properties": {
                                                "threshold_rps": {
                                                    "type": "number",
                                                    "description": "Minimum required requests per second"
                                                },
                                                "unit": {
                                                    "type": "string",
                                                    "enum": [
                                                        "rps",
                                                        "rpm",
                                                        "transactions_per_second"
                                                    ]
                                                }
                                            }
                                        },
                                        "concurrent_users": {
                                            "type": "number",
                                            "description": "Number of concurrent users to simulate"
                                        },
                                        "error_rate": {
                                            "type": "object",
                                            "properties": {
                                                "threshold_percentage": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "maximum": 100
                                                },
                                                "description": "Maximum acceptable error rate"
                                            }
                                        },
                                        "resource_utilization": {
                                            "type": "object",
                                            "properties": {
                                                "cpu_threshold_percentage": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "maximum": 100
                                                },
                                                "memory_threshold_mb": {
                                                    "type": "number"
                                                },
                                                "disk_io_threshold": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "load_model": {
                                    "type": "object",
                                    "description": "Load testing configuration",
                                    "properties": {
                                        "ramp_up_time_seconds": {
                                            "type": "number",
                                            "description": "Time to reach target load"
                                        },
                                        "steady_state_duration_seconds": {
                                            "type": "number",
                                            "description": "Duration to maintain target load"
                                        },
                                        "ramp_down_time_seconds": {
                                            "type": "number",
                                            "description": "Time to return to zero load"
                                        },
                                        "concurrent_users": {
                                            "type": "number",
                                            "description": "Target number of concurrent users"
                                        },
                                        "requests_per_second": {
                                            "type": "number",
                                            "description": "Target request rate"
                                        },
                                        "data_volume_gb": {
                                            "type": "number",
                                            "description": "Data volume for testing"
                                        },
                                        "think_time_ms": {
                                            "type": "number",
                                            "description": "User think time between requests"
                                        }
                                    }
                                },
                                "preconditions": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Conditions that must be met before test execution"
                                },
                                "test_data": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "name": {
                                                "type": "string"
                                            },
                                            "value": {},
                                            "description": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "description": "Test data required for execution"
                                },
                                "steps": {
                                    "type": "array",
                                    "description": "Test execution steps",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "step_number",
                                            "action",
                                            "expected_result"
                                        ],
                                        "properties": {
                                            "step_number": {
                                                "type": "integer",
                                                "minimum": 1
                                            },
                                            "action": {
                                                "type": "string",
                                                "description": "Action to perform"
                                            },
                                            "expected_result": {
                                                "type": "string",
                                                "description": "Expected result after this step"
                                            }
                                        }
                                    }
                                },
                                "success_criteria": {
                                    "type": "string",
                                    "description": "Overall success criteria for the test"
                                },
                                "monitoring_points": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Points to monitor during test execution"
                                },
                                "tools": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Recommended tools for this test (e.g., JMeter, k6, Gatling)"
                                },
                                "notes": {
                                    "type": "string",
                                    "description": "Additional notes or considerations"
                                }
                            }
                        }
                    }
                }
            }
        },
        "security_test_suites": {
            "type": "array",
            "description": "Security test suites covering OWASP Top 10 and authentication/authorization",
            "items": {
                "type": "object",
                "required": [
                    "suite_id",
                    "name",
                    "category",
                    "priority",
                    "test_cases"
                ],
                "properties": {
                    "suite_id": {
                        "type": "string",
                        "pattern": "^STS-\\d{3}$",
                        "description": "Security test suite ID (e.g., STS-001)"
                    },
                    "name": {
                        "type": "string",
                        "description": "Test suite name"
                    },
                    "description": {
                        "type": "string",
                        "description": "Detailed description of what this suite tests"
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "authentication",
                            "authorization",
                            "injection",
                            "cryptographic",
                            "misconfiguration",
                            "components",
                            "logging",
                            "data_integrity",
                            "access_control",
                            "ssrf"
                        ],
                        "description": "Security test category mapped to OWASP Top 10"
                    },
                    "owasp_reference": {
                        "type": "string",
                        "description": "Reference to OWASP Top 10 category (e.g., A01:2021, A07:2021)"
                    },
                    "component": {
                        "type": "string",
                        "description": "Component or endpoint under test"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "P0",
                            "P1",
                            "P2"
                        ]
                    },
                    "test_cases": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "test_id",
                                "title",
                                "scenario",
                                "attack_vector",
                                "validation_method",
                                "steps",
                                "expected_secure_behavior"
                            ],
                            "properties": {
                                "test_id": {
                                    "type": "string",
                                    "pattern": "^SEC-\\d{4}$",
                                    "description": "Security test case ID (e.g., SEC-0001)"
                                },
                                "title": {
                                    "type": "string",
                                    "description": "Short, descriptive title"
                                },
                                "description": {
                                    "type": "string",
                                    "description": "Detailed description of the test case"
                                },
                                "priority": {
                                    "type": "string",
                                    "enum": [
                                        "P0",
                                        "P1",
                                        "P2"
                                    ]
                                },
                                "scenario": {
                                    "type": "string",
                                    "description": "Test scenario description"
                                },
                                "attack_vector": {
                                    "type": "string",
                                    "description": "Type of attack or vulnerability being tested"
                                },
                                "vulnerability_type": {
                                    "type": "string",
                                    "enum": [
                                        "sql_injection",
                                        "xss",
                                        "csrf",
                                        "auth_bypass",
                                        "privilege_escalation",
                                        "sensitive_data_exposure",
                                        "command_injection",
                                        "path_traversal",
                                        "ssrf",
                                        "xxe",
                                        "insecure_deserialization",
                                        "weak_cryptography",
                                        "session_fixation",
                                        "open_redirect",
                                        "file_inclusion"
                                    ],
                                    "description": "Specific vulnerability type"
                                },
                                "validation_method": {
                                    "type": "string",
                                    "description": "How to validate the vulnerability (without causing harm)"
                                },
                                "preconditions": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "test_data": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "name": {
                                                "type": "string"
                                            },
                                            "value": {},
                                            "description": {
                                                "type": "string"
                                            },
                                            "is_malicious": {
                                                "type": "boolean",
                                                "description": "Whether this is malicious test data"
                                            }
                                        }
                                    }
                                },
                                "steps": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "step_number",
                                            "action",
                                            "expected_result"
                                        ],
                                        "properties": {
                                            "step_number": {
                                                "type": "integer",
                                                "minimum": 1
                                            },
                                            "action": {
                                                "type": "string"
                                            },
                                            "expected_result": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "expected_secure_behavior": {
                                    "type": "string",
                                    "description": "Expected secure behavior (vulnerability should be prevented)"
                                },
                                "remediation": {
                                    "type": "string",
                                    "description": "Suggested remediation if vulnerability is found"
                                },
                                "tools": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Recommended security testing tools (e.g., OWASP ZAP, Burp Suite)"
                                },
                                "compliance_reference": {
                                    "type": "string",
                                    "description": "Reference to compliance requirement (e.g., SOC 2, GDPR, PCI DSS)"
                                },
                                "notes": {
                                    "type": "string",
                                    "description": "Additional safety notes or constraints"
                                }
                            }
                        }
                    }
                }
            }
        },
        "accessibility_test_suites": {
            "type": "array",
            "description": "Accessibility test suites covering WCAG compliance and assistive technologies",
            "items": {
                "type": "object",
                "required": [
                    "suite_id",
                    "name",
                    "category",
                    "priority",
                    "test_cases"
                ],
                "properties": {
                    "suite_id": {
                        "type": "string",
                        "pattern": "^ATS-\\d{3}$",
                        "description": "Accessibility test suite ID (e.g., ATS-001)"
                    },
                    "name": {
                        "type": "string",
                        "description": "Test suite name"
                    },
                    "description": {
                        "type": "string",
                        "description": "Detailed description of what this suite tests"
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "perceivable",
                            "operable",
                            "understandable",
                            "robust"
                        ],
                        "description": "WCAG principle category"
                    },
                    "wcag_level": {
                        "type": "string",
                        "enum": [
                            "A",
                            "AA",
                            "AAA"
                        ],
                        "description": "WCAG compliance level"
                    },
                    "ui_component": {
                        "type": "string",
                        "description": "UI component or page being tested"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "P0",
                            "P1",
                            "P2"
                        ]
                    },
                    "test_cases": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "test_id",
                                "title",
                                "scenario",
                                "wcag_criterion",
                                "test_method",
                                "steps",
                                "expected_accessible_behavior"
                            ],
                            "properties": {
                                "test_id": {
                                    "type": "string",
                                    "pattern": "^A11Y-\\d{4}$",
                                    "description": "Accessibility test case ID (e.g., A11Y-0001)"
                                },
                                "title": {
                                    "type": "string",
                                    "description": "Short, descriptive title"
                                },
                                "description": {
                                    "type": "string",
                                    "description": "Detailed description of the test case"
                                },
                                "priority": {
                                    "type": "string",
                                    "enum": [
                                        "P0",
                                        "P1",
                                        "P2"
                                    ]
                                },
                                "scenario": {
                                    "type": "string",
                                    "description": "Test scenario description"
                                },
                                "wcag_criterion": {
                                    "type": "string",
                                    "description": "WCAG success criterion (e.g., 1.4.3 Contrast (Minimum))"
                                },
                                "wcag_reference": {
                                    "type": "string",
                                    "description": "Full WCAG reference (e.g., https://www.w3.org/WAI/WCAG21/Understanding/contrast-minimum.html)"
                                },
                                "test_method": {
                                    "type": "string",
                                    "enum": [
                                        "automated",
                                        "manual",
                                        "screen_reader",
                                        "keyboard_only",
                                        "magnifier"
                                    ],
                                    "description": "Testing method"
                                },
                                "assistive_technology": {
                                    "type": "object",
                                    "description": "Assistive technology configuration",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "nvda",
                                                "jaws",
                                                "voiceover",
                                                "narrator",
                                                "talkback",
                                                "voice_assistant"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        },
                                        "browser": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "preconditions": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Setup required before testing"
                                },
                                "test_data": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "name": {
                                                "type": "string"
                                            },
                                            "value": {},
                                            "description": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "steps": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "step_number",
                                            "action",
                                            "expected_result"
                                        ],
                                        "properties": {
                                            "step_number": {
                                                "type": "integer",
                                                "minimum": 1
                                            },
                                            "action": {
                                                "type": "string"
                                            },
                                            "expected_result": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "expected_accessible_behavior": {
                                    "type": "string",
                                    "description": "Expected accessible behavior"
                                },
                                "success_criteria": {
                                    "type": "string",
                                    "description": "Specific success criteria for this test"
                                },
                                "tools": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Recommended accessibility testing tools (e.g., axe, WAVE, Lighthouse)"
                                },
                                "browser_combinations": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Browser and screen reader combinations to test"
                                },
                                "improvement_suggestions": {
                                    "type": "string",
                                    "description": "Suggestions for improving accessibility if test fails"
                                },
                                "notes": {
                                    "type": "string",
                                    "description": "Additional notes"
                                }
                            }
                        }
                    }
                }
            }
        },
        "performance_metrics": {
            "type": "object",
            "description": "Overall performance metrics and thresholds",
            "properties": {
                "response_time_thresholds": {
                    "type": "object",
                    "properties": {
                        "p50_ms": {
                            "type": "number"
                        },
                        "p95_ms": {
                            "type": "number"
                        },
                        "p99_ms": {
                            "type": "number"
                        }
                    }
                },
                "throughput_targets": {
                    "type": "object",
                    "properties": {
                        "requests_per_second": {
                            "type": "number"
                        },
                        "concurrent_users": {
                            "type": "number"
                        }
                    }
                },
                "resource_limits": {
                    "type": "object",
                    "properties": {
                        "cpu_percentage": {
                            "type": "number",
                            "maximum": 100
                        },
                        "memory_mb": {
                            "type": "number"
                        },
                        "disk_io": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "owasp_top10_coverage": {
            "type": "object",
            "description": "Coverage matrix for OWASP Top 10 (2021)",
            "properties": {
                "A01_2021_broken_access_control": {
                    "type": "boolean"
                },
                "A02_2021_cryptographic_failures": {
                    "type": "boolean"
                },
                "A03_2021_injection": {
                    "type": "boolean"
                },
                "A04_2021_insecure_design": {
                    "type": "boolean"
                },
                "A05_2021_security_misconfiguration": {
                    "type": "boolean"
                },
                "A06_2021_vulnerable_outdated_components": {
                    "type": "boolean"
                },
                "A07_2021_identification_authentication_failures": {
                    "type": "boolean"
                },
                "A08_2021_software_data_integrity_failures": {
                    "type": "boolean"
                },
                "A09_2021_security_logging_monitoring_failures": {
                    "type": "boolean"
                },
                "A10_2021_server_side_request_forgery": {
                    "type": "boolean"
                }
            }
        },
        "wcag_coverage": {
            "type": "object",
            "description": "Coverage matrix for WCAG 2.1/2.2",
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "A",
                        "AA",
                        "AAA"
                    ]
                },
                "perceivable_criteria_covered": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "operable_criteria_covered": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "understandable_criteria_covered": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "robust_criteria_covered": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "risk_matrices": {
            "type": "object",
            "description": "Risk assessment matrices for prioritization",
            "properties": {
                "performance_risks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "component": {
                                "type": "string"
                            },
                            "risk_level": {
                                "type": "string",
                                "enum": [
                                    "high",
                                    "medium",
                                    "low"
                                ]
                            },
                            "risk_description": {
                                "type": "string"
                            },
                            "mitigation": {
                                "type": "string"
                            }
                        }
                    }
                },
                "security_risks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "component": {
                                "type": "string"
                            },
                            "vulnerability_type": {
                                "type": "string"
                            },
                            "risk_level": {
