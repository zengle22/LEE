{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract.test.e2e_suite.v1",
  "title": "E2E Test Suite Contract",
  "description": "E2E 测试用例集合定义，包含用例列表、优先级、标签和执行配置",
  "type": "object",
  "required": ["suite_id", "name", "platform", "cases"],
  "properties": {
    "suite_id": {
      "type": "string",
      "pattern": "^E2E-SUITE-[A-Z0-9-]+$",
      "description": "用例集唯一标识",
      "examples": ["E2E-SUITE-CORE-FLOW", "E2E-SUITE-AUTH"]
    },
    "name": {
      "type": "string",
      "description": "用例集名称"
    },
    "description": {
      "type": "string",
      "description": "用例集描述"
    },
    "platform": {
      "type": "string",
      "enum": ["chrome", "wechat-miniprogram", "h5", "all"],
      "description": "目标平台"
    },
    "version": {
      "type": "string",
      "description": "用例集版本"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "用例集标签",
      "examples": [["smoke", "core-flow", "p0"]]
    },
    "config": {
      "type": "object",
      "description": "执行配置",
      "properties": {
        "parallel": {
          "type": "boolean",
          "default": false,
          "description": "是否并行执行"
        },
        "max_parallel": {
          "type": "integer",
          "default": 3,
          "description": "最大并行数"
        },
        "timeout_per_case_ms": {
          "type": "integer",
          "default": 60000,
          "description": "单用例超时(毫秒)"
        },
        "retry_on_failure": {
          "type": "integer",
          "default": 1,
          "description": "失败重试次数"
        },
        "fail_fast": {
          "type": "boolean",
          "default": false,
          "description": "遇到失败是否立即停止"
        },
        "browser": {
          "type": "object",
          "description": "浏览器配置",
          "properties": {
            "headless": { "type": "boolean", "default": true },
            "viewport": {
              "type": "object",
              "properties": {
                "width": { "type": "integer", "default": 1280 },
                "height": { "type": "integer", "default": 720 }
              }
            },
            "slow_mo": { "type": "integer", "default": 0 },
            "record_video": { "type": "boolean", "default": true },
            "record_trace": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "env_requirements": {
      "type": "object",
      "description": "环境要求",
      "properties": {
        "base_url": {
          "type": "string",
          "description": "测试基础 URL"
        },
        "wechat_appid": {
          "type": "string",
          "description": "小程序 AppID (如适用)"
        },
        "test_accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "username": { "type": "string" },
              "password": { "type": "string" }
            }
          },
          "description": "测试账号列表"
        },
        "test_data": {
          "type": "object",
          "description": "测试数据配置"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/E2ECase"
      },
      "description": "用例列表"
    }
  },
  "$defs": {
    "E2ECase": {
      "type": "object",
      "required": ["case_id", "name", "priority", "steps"],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^E2E-[A-Z]+-[0-9]+$",
          "description": "用例 ID",
          "examples": ["E2E-AUTH-001", "E2E-PLAN-003"]
        },
        "name": {
          "type": "string",
          "description": "用例名称"
        },
        "description": {
          "type": "string",
          "description": "用例描述"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2"],
          "description": "优先级 (P0=核心链路, P1=重要功能, P2=次要功能)"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "用例标签"
        },
        "module": {
          "type": "string",
          "description": "所属模块"
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "前置条件"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/E2EStep"
          },
          "description": "执行步骤"
        },
        "expected_result": {
          "type": "string",
          "description": "预期最终结果"
        },
        "cleanup": {
          "type": "array",
          "items": { "type": "string" },
          "description": "清理步骤"
        },
        "timeout_ms": {
          "type": "integer",
          "description": "用例级超时覆盖"
        },
        "skip_reason": {
          "type": "string",
          "description": "跳过原因 (如设置则跳过)"
        }
      }
    },
    "E2EStep": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "step": {
          "type": "integer",
          "description": "步骤序号"
        },
        "action": {
          "type": "string",
          "enum": [
            "navigate", "click", "fill", "select", "check", "uncheck",
            "hover", "scroll", "wait", "screenshot", "assert_visible",
            "assert_text", "assert_url", "assert_element", "assert_network",
            "custom"
          ],
          "description": "动作类型"
        },
        "selector": {
          "type": "string",
          "description": "元素选择器 (推荐 data-testid)"
        },
        "value": {
          "type": "string",
          "description": "输入值或目标值"
        },
        "options": {
          "type": "object",
          "description": "动作选项"
        },
        "expected": {
          "type": "string",
          "description": "预期结果"
        },
        "soft_assert": {
          "type": "boolean",
          "default": false,
          "description": "软断言 (失败继续执行)"
        },
        "screenshot_on_step": {
          "type": "boolean",
          "default": false,
          "description": "步骤完成后截图"
        },
        "description": {
          "type": "string",
          "description": "步骤描述"
        }
      }
    }
  }
}
