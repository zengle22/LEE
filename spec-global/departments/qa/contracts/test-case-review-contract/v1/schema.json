{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/test-case-review-contract/v1/schema.json",
    "title": "Test Case Review Contract Schema",
    "description": "Schema for test case review reports generated by Test Case Reviewer agent",
    "type": "object",
    "required": [
        "contract_type",
        "contract_version",
        "metadata",
        "review_summary",
        "dimension_scores",
        "findings",
        "coverage_analysis",
        "improvement_suggestions"
    ],
    "properties": {
        "contract_type": {
            "type": "string",
            "const": "test-case-review"
        },
        "contract_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "metadata": {
            "type": "object",
            "required": [
                "contract_id",
                "product_name",
                "review_date",
                "reviewer",
                "test_case_contract_id"
            ],
            "properties": {
                "contract_id": {
                    "type": "string",
                    "pattern": "^TCR-\\d{8}-\\d{3}$",
                    "description": "Unique test case review contract ID (e.g., TCR-20260205-001)"
                },
                "product_name": {
                    "type": "string",
                    "description": "Product or feature name being reviewed"
                },
                "review_date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 timestamp when review was performed"
                },
                "reviewer": {
                    "type": "string",
                    "description": "Agent or human who performed the review"
                },
                "test_case_contract_id": {
                    "type": "string",
                    "description": "Reference to the test case contract being reviewed"
                },
                "prd_contract_id": {
                    "type": "string",
                    "description": "Reference to the source PRD contract"
                },
                "architecture_contract_id": {
                    "type": "string",
                    "description": "Reference to the source architecture contract"
                },
                "ui_contract_id": {
                    "type": "string",
                    "description": "Reference to the UI contract (if applicable)"
                }
            }
        },
        "review_summary": {
            "type": "object",
            "required": [
                "total_score",
                "rating",
                "total_test_cases",
                "total_findings"
            ],
            "properties": {
                "total_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Overall weighted score across all dimensions"
                },
                "rating": {
                    "type": "string",
                    "enum": [
                        "EXCELLENT",
                        "GOOD",
                        "FAIR",
                        "POOR"
                    ],
                    "description": "Overall rating based on total score (>=90: EXCELLENT, >=70: GOOD, >=50: FAIR, <50: POOR)"
                },
                "total_test_cases": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Total number of test cases reviewed"
                },
                "total_findings": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Total number of findings identified"
                },
                "recommendation": {
                    "type": "string",
                    "enum": [
                        "APPROVED",
                        "APPROVED_WITH_SUGGESTIONS",
                        "REVISION_REQUIRED",
                        "REJECTED"
                    ],
                    "description": "Review outcome recommendation"
                },
                "summary_text": {
                    "type": "string",
                    "description": "Human-readable summary of the review"
                }
            }
        },
        "dimension_scores": {
            "type": "array",
            "description": "Scores for each review dimension",
            "items": {
                "type": "object",
                "required": [
                    "dimension",
                    "score",
                    "weight",
                    "weighted_score",
                    "status"
                ],
                "properties": {
                    "dimension": {
                        "type": "string",
                        "enum": [
                            "completeness",
                            "accuracy",
                            "coverage",
                            "contract_compliance",
                            "executability"
                        ],
                        "description": "Review dimension name"
                    },
                    "dimension_name": {
                        "type": "string",
                        "description": "Human-readable dimension name (e.g., 'Completeness', 'Accuracy')"
                    },
                    "score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "description": "Raw score for this dimension (0-100)"
                    },
                    "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Weight of this dimension in overall score"
                    },
                    "weighted_score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "description": "Weighted contribution to overall score"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "PASS",
                            "WARNING",
                            "FAIL"
                        ],
                        "description": "Status of this dimension (>=70: PASS, >=50: WARNING, <50: FAIL)"
                    },
                    "details": {
                        "type": "array",
                        "description": "Detailed assessment items",
                        "items": {
                            "type": "object",
                            "properties": {
                                "criterion": {
                                    "type": "string",
                                    "description": "Criterion name"
                                },
                                "passed": {
                                    "type": "boolean"
                                },
                                "notes": {
                                    "type": "string",
                                    "description": "Additional notes"
                                }
                            }
                        }
                    }
                }
            }
        },
        "findings": {
            "type": "array",
            "description": "List of all findings identified during review",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "severity",
                    "category",
                    "title",
                    "description"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^F-\\d{4}$",
                        "description": "Unique finding ID (e.g., F-0001)"
                    },
                    "severity": {
                        "type": "string",
                        "enum": [
                            "blocker",
                            "major",
                            "minor",
                            "nit"
                        ],
                        "description": "Severity level (blocker: must fix before approval, major: should fix, minor: nice to fix, nit: trivial)"
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "completeness",
                            "accuracy",
                            "coverage",
                            "contract_compliance",
                            "executability",
                            "priority",
                            "other"
                        ],
                        "description": "Category of the finding"
                    },
                    "dimension": {
                        "type": "string",
                        "description": "Review dimension this finding belongs to"
                    },
                    "title": {
                        "type": "string",
                        "description": "Short title of the finding"
                    },
                    "description": {
                        "type": "string",
                        "description": "Detailed description of the issue"
                    },
                    "location": {
                        "type": "object",
                        "description": "Location of the issue in the test cases",
                        "properties": {
                            "suite_id": {
                                "type": "string",
                                "description": "Test suite ID where issue was found"
                            },
                            "test_id": {
                                "type": "string",
                                "description": "Test case ID where issue was found"
                            },
                            "field": {
                                "type": "string",
                                "description": "Field name with the issue"
                            },
                            "json_path": {
                                "type": "string",
                                "description": "JSONPath to the issue location"
                            }
                        }
                    },
                    "impact": {
                        "type": "string",
                        "description": "Impact of this finding on test quality"
                    },
                    "suggestion": {
                        "type": "string",
                        "description": "Specific suggestion for fixing the issue"
                    },
                    "example_fix": {
                        "type": "string",
                        "description": "Example of how to fix the issue"
                    }
                }
            }
        },
        "coverage_analysis": {
            "type": "object",
            "required": [
                "feature_coverage",
                "ac_coverage",
                "priority_coverage"
            ],
            "properties": {
                "feature_coverage": {
                    "type": "object",
                    "properties": {
                        "total_features": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "covered_features": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "coverage_percentage": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        },
                        "uncovered_features": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "feature_id": {
                                        "type": "string"
                                    },
                                    "feature_name": {
                                        "type": "string"
                                    },
                                    "priority": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "ac_coverage": {
                    "type": "object",
                    "properties": {
                        "total_acceptance_criteria": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "covered_ac": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "coverage_percentage": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        },
                        "uncovered_ac": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "ac_id": {
                                        "type": "string"
                                    },
                                    "ac_text": {
                                        "type": "string"
                                    },
                                    "feature_id": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "priority_coverage": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "priority": {
                                "type": "string",
                                "enum": ["P0", "P1", "P2"]
                            },
                            "total_items": {
                                "type": "integer"
                            },
                            "covered_items": {
                                "type": "integer"
                            },
                            "coverage_percentage": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "meets_threshold": {
                                "type": "boolean"
                            }
                        }
                    }
                },
                "coverage_gaps": {
                    "type": "array",
                    "description": "Identified gaps in test coverage",
                    "items": {
                        "type": "object",
                        "properties": {
                            "gap_type": {
                                "type": "string",
                                "enum": [
                                    "missing_feature",
                                    "missing_ac",
                                    "missing_negative_test",
                                    "missing_boundary_test",
                                    "missing_integration_test"
                                ]
                            },
                            "description": {
                                "type": "string"
                            },
                            "severity": {
                                "type": "string",
                                "enum": ["high", "medium", "low"]
                            },
                            "suggested_test_cases": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "improvement_suggestions": {
            "type": "array",
            "description": "Actionable improvement suggestions",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "priority",
                    "category",
                    "suggestion"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^S-\\d{4}$",
                        "description": "Unique suggestion ID (e.g., S-0001)"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "high",
                            "medium",
                            "low"
                        ],
                        "description": "Priority of implementing this suggestion"
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "add_test_cases",
                            "modify_test_cases",
                            "improve_clarity",
                            "add_test_data",
                            "adjust_priority",
                            "automation",
                            "other"
                        ]
                    },
                    "suggestion": {
                        "type": "string",
                        "description": "Description of the suggestion"
                    },
                    "rationale": {
                        "type": "string",
                        "description": "Why this suggestion is important"
                    },
                    "related_findings": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "References to related finding IDs"
                    },
                    "estimated_effort": {
                        "type": "string",
                        "description": "Estimated effort to implement (e.g., 'low', 'medium', 'high')"
                    }
                }
            }
        },
        "contract_compliance": {
            "type": "object",
            "description": "Contract schema compliance check results",
            "properties": {
                "is_compliant": {
                    "type": "boolean"
                },
                "validation_errors": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "error_type": {
                                "type": "string",
                                "enum": [
                                    "missing_required_field",
                                    "invalid_format",
                                    "invalid_enum",
                                    "pattern_mismatch",
                                    "reference_error"
                                ]
                            },
                            "location": {
                                "type": "string"
                            },
                            "message": {
                                "type": "string"
                            }
                        }
                    }
                },
                "compliance_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                }
            }
        },
        "test_statistics": {
            "type": "object",
            "description": "Additional statistics about the test cases",
            "properties": {
                "by_priority": {
                    "type": "object",
                    "properties": {
                        "P0": {
                            "type": "integer"
                        },
                        "P1": {
                            "type": "integer"
                        },
                        "P2": {
                            "type": "integer"
                        }
                    }
                },
                "by_type": {
                    "type": "object",
                    "properties": {
                        "unit": {
                            "type": "integer"
                        },
                        "integration": {
                            "type": "integer"
                        },
                        "e2e": {
                            "type": "integer"
                        },
                        "performance": {
                            "type": "integer"
                        },
                        "security": {
                            "type": "integer"
                        },
                        "accessibility": {
                            "type": "integer"
                        }
                    }
                },
                "automatable": {
                    "type": "integer",
                    "description": "Number of test cases marked as automatable"
                },
                "automation_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Percentage of test cases that are automatable"
                }
            }
        },
        "next_steps": {
            "type": "array",
            "description": "Recommended next steps",
            "items": {
                "type": "object",
                "properties": {
                    "step": {
                        "type": "string"
                    },
                    "responsible": {
                        "type": "string"
                    },
                    "timeline": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
