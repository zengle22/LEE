{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/playwright-script-output/v1/schema.json",
    "title": "Playwright Script Output Schema",
    "description": "Schema for Playwright test script generation output",
    "type": "object",
    "required": [
        "contract_type",
        "contract_version",
        "metadata",
        "output"
    ],
    "properties": {
        "contract_type": {
            "type": "string",
            "const": "playwright-script-output"
        },
        "contract_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "metadata": {
            "type": "object",
            "required": [
                "contract_id",
                "generator_agent",
                "generated_date",
                "source_test_case"
            ],
            "properties": {
                "contract_id": {
                    "type": "string",
                    "pattern": "^PSO-\\d{8}-\\d{3}$",
                    "description": "Unique Playwright Script Output contract ID (e.g., PSO-20260121-001)"
                },
                "generator_agent": {
                    "type": "string",
                    "description": "Agent that generated the scripts (e.g., agent.qa.playwright_script_generator)"
                },
                "generated_date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 timestamp when scripts were generated"
                },
                "source_test_case": {
                    "type": "string",
                    "description": "Reference to the source test case contract ID"
                },
                "source_ui_contracts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "References to the source UI contract IDs"
                }
            }
        },
        "output": {
            "type": "object",
            "required": [
                "files",
                "statistics",
                "configuration"
            ],
            "properties": {
                "files": {
                    "type": "array",
                    "description": "Generated files",
                    "items": {
                        "type": "object",
                        "required": [
                            "path",
                            "type",
                            "content",
                            "exists"
                        ],
                        "properties": {
                            "path": {
                                "type": "string",
                                "description": "Relative path to the generated file"
                            },
                            "type": {
                                "type": "string",
                                "enum": [
                                    "config",
                                    "page-object",
                                    "test-spec",
                                    "test-data",
                                    "type-definition"
                                ],
                                "description": "Type of the generated file"
                            },
                            "content": {
                                "type": "string",
                                "description": "File content (base64 encoded for binary files)"
                            },
                            "size_bytes": {
                                "type": "integer",
                                "description": "File size in bytes"
                            },
                            "exists": {
                                "type": "boolean",
                                "description": "Whether the file was successfully created"
                            },
                            "language": {
                                "type": "string",
                                "enum": ["typescript", "json", "csv"],
                                "description": "Programming language or format"
                            }
                        }
                    }
                },
                "statistics": {
                    "type": "object",
                    "description": "Generation statistics",
                    "properties": {
                        "total_files": {
                            "type": "integer",
                            "description": "Total number of files generated"
                        },
                        "page_objects": {
                            "type": "integer",
                            "description": "Number of Page Object classes generated"
                        },
                        "test_specs": {
                            "type": "integer",
                            "description": "Number of test spec files generated"
                        },
                        "test_cases": {
                            "type": "integer",
                            "description": "Total number of test cases generated"
                        },
                        "test_data_files": {
                            "type": "integer",
                            "description": "Number of test data files generated"
                        },
                        "lines_of_code": {
                            "type": "integer",
                            "description": "Total lines of test code generated"
                        },
                        "estimated_execution_time": {
                            "type": "string",
                            "description": "Estimated execution time for all tests (e.g., '5m 30s')"
                        }
                    }
                },
                "configuration": {
                    "type": "object",
                    "description": "Playwright configuration",
                    "properties": {
                        "browser": {
                            "type": "string",
                            "enum": ["chromium", "firefox", "webkit"],
                            "description": "Target browser"
                        },
                        "headless": {
                            "type": "boolean",
                            "description": "Whether to run tests in headless mode"
                        },
                        "base_url": {
                            "type": "string",
                            "format": "uri",
                            "description": "Base URL for tests"
                        },
                        "timeout": {
                            "type": "integer",
                            "description": "Default timeout in milliseconds"
                        },
                        "screenshot": {
                            "type": "string",
                            "enum": ["only-on-failure", "always", "never"],
                            "description": "Screenshot configuration"
                        },
                        "trace": {
                            "type": "string",
                            "enum": ["on-first-retry", "on-all-retries", "retain-on-failure", "off"],
                            "description": "Trace configuration"
                        },
                        "video": {
                            "type": "string",
                            "enum": ["retain-on-failure", "on", "off"],
                            "description": "Video recording configuration"
                        }
                    }
                },
                "selector_analysis": {
                    "type": "object",
                    "description": "Analysis of selector usage",
                    "properties": {
                        "primary_selector": {
                            "type": "string",
                            "enum": ["data-testid", "role", "aria-label", "css", "xpath"],
                            "description": "Primary selector type used"
                        },
                        "stability_score": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Selector stability score (1.0 = most stable)"
                        },
                        "selector_distribution": {
                            "type": "object",
                            "description": "Distribution of selector types",
                            "properties": {
                                "data-testid": {
                                    "type": "integer",
                                    "description": "Count of data-testid selectors"
                                },
                                "role": {
                                    "type": "integer",
                                    "description": "Count of role selectors"
                                },
                                "aria-label": {
                                    "type": "integer",
                                    "description": "Count of aria-label selectors"
                                },
                                "css": {
                                    "type": "integer",
                                    "description": "Count of CSS selectors"
                                },
                                "xpath": {
                                    "type": "integer",
                                    "description": "Count of XPath selectors"
                                }
                            }
                        }
                    }
                },
                "test_structure": {
                    "type": "object",
                    "description": "Test structure information",
                    "properties": {
                        "uses_page_object": {
                            "type": "boolean",
                            "description": "Whether Page Object Model is used"
                        },
                        "base_page_class": {
                            "type": "string",
                            "description": "Name of the base page class"
                        },
                        "page_classes": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "List of generated page class names"
                        },
                        "test_suites": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "file": {
                                        "type": "string"
                                    },
                                    "test_count": {
                                        "type": "integer"
                                    }
                                }
                            },
                            "description": "List of test suites"
                        },
                        "uses_test_data": {
                            "type": "boolean",
                            "description": "Whether tests use external test data"
                        },
                        "test_data_files": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "List of test data file names"
                        },
                        "uses_data_driven": {
                            "type": "boolean",
                            "description": "Whether any tests are data-driven"
                        }
                    }
                },
                "quality_metrics": {
                    "type": "object",
                    "description": "Quality metrics for generated code",
                    "properties": {
                        "has_assertions": {
                            "type": "boolean",
                            "description": "Whether all tests have assertions"
                        },
                        "has_error_handling": {
                            "type": "boolean",
                            "description": "Whether tests include error handling"
                        },
                        "has_retry_logic": {
                            "type": "boolean",
                            "description": "Whether tests use retry logic"
                        },
                        "uses_explicit_waits": {
                            "type": "boolean",
                            "description": "Whether tests use explicit waits"
                        },
                        "typescript_strict": {
                            "type": "boolean",
                            "description": "Whether TypeScript strict mode is enabled"
                        },
                        "accessibility_tests": {
                            "type": "integer",
                            "description": "Number of accessibility tests included"
                        }
                    }
                },
                "recommendations": {
                    "type": "array",
                    "description": "Recommendations for test improvement",
                    "items": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": ["warning", "suggestion", "error"],
                                "description": "Type of recommendation"
                            },
                            "category": {
                                "type": "string",
                                "enum": ["selector", "performance", "maintainability", "coverage", "accessibility"],
                                "description": "Category of the recommendation"
                            },
                            "message": {
                                "type": "string",
                                "description": "Recommendation message"
                            },
                            "suggestion": {
                                "type": "string",
                                "description": "Suggested action"
                            }
                        }
                    }
                },
                "next_steps": {
                    "type": "array",
                    "description": "Suggested next steps",
                    "items": {
                        "type": "object",
                        "properties": {
                            "step": {
                                "type": "string",
                                "description": "Next step description"
                            },
                            "agent": {
                                "type": "string",
                                "description": "Agent responsible for this step (if applicable)"
                            },
                            "priority": {
                                "type": "string",
                                "enum": ["high", "medium", "low"],
                                "description": "Priority of the step"
                            }
                        }
                    }
                }
            }
        },
        "validation": {
            "type": "object",
            "description": "Validation results",
            "properties": {
                "typescript_valid": {
                    "type": "boolean",
                    "description": "Whether generated TypeScript code is valid"
                },
                "playwright_config_valid": {
                    "type": "boolean",
                    "description": "Whether Playwright config is valid"
                },
                "test_structure_valid": {
                    "type": "boolean",
                    "description": "Whether test structure is valid"
                },
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "file": {
                                "type": "string"
                            },
                            "line": {
                                "type": "integer"
                            },
                            "message": {
                                "type": "string"
                            },
                            "severity": {
                                "type": "string",
                                "enum": ["error", "warning"]
                            }
                        }
                    },
                    "description": "Validation errors and warnings"
                }
            }
        }
    }
}
