{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/observability/log-entry/v1",
  "title": "Log Entry Schema",
  "description": "统一日志条目 JSON Schema - 用于 CI 校验日志格式合规性",
  "type": "object",
  "required": [
    "ts",
    "level",
    "service",
    "event"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "时间戳 (ISO 8601 格式)"
    },
    "level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARN", "ERROR", "FATAL"],
      "description": "日志级别"
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "description": "服务名称"
    },
    "env": {
      "type": "string",
      "enum": ["dev", "test", "staging", "production"],
      "description": "环境"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+.*$",
      "description": "服务版本"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "分布式追踪 ID (32位十六进制)"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "Span ID (16位十六进制)"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9]+$",
      "description": "请求 ID (格式: req_xxx)"
    },
    "client_request_id": {
      "type": "string",
      "pattern": "^cr_[A-Za-z0-9]+$",
      "description": "客户端请求 ID (格式: cr_xxx)"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z_]+$",
      "description": "事件类型 (格式: category.action)",
      "examples": [
        "http.request",
        "http.response",
        "db.query",
        "cache.get",
        "ui.action",
        "domain.event"
      ]
    },
    "msg": {
      "type": "string",
      "description": "人类可读的日志消息"
    },
    "route": {
      "type": "string",
      "description": "API 路由"
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
      "description": "HTTP 方法"
    },
    "status_code": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "HTTP 状态码"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0,
      "description": "延迟毫秒"
    },
    "client_platform": {
      "type": "string",
      "enum": ["web", "weapp", "ios", "android", "desktop", "server"],
      "description": "客户端平台"
    },
    "client_version": {
      "type": "string",
      "description": "客户端版本"
    },
    "user_id_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "用户 ID 哈希 (SHA-256)"
    },
    "session_id": {
      "type": "string",
      "description": "会话 ID"
    },
    "ip_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "IP 地址哈希 (SHA-256)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "标签列表 (用于快速过滤)"
    },
    "sampled": {
      "type": "boolean",
      "description": "是否为采样日志"
    },
    "error": {
      "$ref": "#/$defs/Error"
    },
    "page": {
      "type": "string",
      "description": "页面名称 (前端日志)"
    },
    "component": {
      "type": "string",
      "description": "组件名称 (前端日志)"
    },
    "action": {
      "type": "string",
      "description": "用户动作类型",
      "examples": ["click", "submit", "navigate", "scroll"]
    },
    "target": {
      "type": "string",
      "description": "动作目标 (如 data-testid)"
    },
    "db": {
      "$ref": "#/$defs/DatabaseContext"
    },
    "entity_type": {
      "type": "string",
      "description": "业务实体类型",
      "examples": ["plan", "run", "user", "session", "order"]
    },
    "entity_id_hash": {
      "type": "string",
      "description": "业务实体 ID 哈希"
    },
    "operation": {
      "type": "string",
      "enum": ["create", "read", "update", "delete", "list"],
      "description": "操作类型"
    },
    "result": {
      "type": "string",
      "enum": ["success", "fail", "partial"],
      "description": "操作结果"
    }
  },
  "anyOf": [
    { "required": ["trace_id"] },
    { "required": ["request_id"] }
  ],
  "$defs": {
    "Error": {
      "type": "object",
      "required": ["code", "type", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "description": "错误码 (必须稳定、可枚举)",
          "examples": [
            "AUTH_TOKEN_EXPIRED",
            "VALIDATION_FAILED",
            "RESOURCE_NOT_FOUND",
            "DB_CONNECTION_FAILED"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "BusinessError",
            "ValidationError",
            "AuthenticationError",
            "AuthorizationError",
            "NotFoundError",
            "ConflictError",
            "RateLimitError",
            "InternalError",
            "ExternalServiceError",
            "DatabaseError",
            "CacheError",
            "NetworkError"
          ],
          "description": "错误类型分类"
        },
        "message": {
          "type": "string",
          "description": "错误消息"
        },
        "stack": {
          "type": "string",
          "description": "堆栈追踪 (仅服务端)"
        },
        "cause": {
          "type": "string",
          "description": "根因描述"
        },
        "retryable": {
          "type": "boolean",
          "description": "是否可重试"
        },
        "details": {
          "type": "object",
          "description": "额外错误详情"
        }
      }
    },
    "DatabaseContext": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "enum": ["postgres", "mysql", "mongodb", "redis", "sqlite"],
          "description": "数据库系统"
        },
        "name": {
          "type": "string",
          "description": "数据库名称"
        },
        "operation": {
          "type": "string",
          "enum": ["select", "insert", "update", "delete", "transaction", "index"],
          "description": "数据库操作类型"
        },
        "table": {
          "type": "string",
          "description": "表名"
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "description": "影响的行数"
        }
      }
    }
  },
  "examples": [
    {
      "ts": "2026-01-13T13:21:09.231Z",
      "level": "INFO",
      "service": "api-gateway",
      "env": "test",
      "version": "v0.8.3-rc2",
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "span_id": "00f067aa0ba902b7",
      "request_id": "req_01HXYZ123",
      "event": "http.request",
      "method": "POST",
      "route": "/api/v1/orders",
      "msg": "Incoming request"
    },
    {
      "ts": "2026-01-13T13:21:09.500Z",
      "level": "ERROR",
      "service": "order-service",
      "env": "test",
      "version": "v1.2.0",
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "request_id": "req_01HXYZ123",
      "event": "domain.event",
      "entity_type": "order",
      "operation": "create",
      "result": "fail",
      "error": {
        "code": "INVENTORY_INSUFFICIENT",
        "type": "BusinessError",
        "message": "Not enough inventory for SKU-001",
        "retryable": false
      }
    },
    {
      "ts": "2026-01-13T10:30:45.100Z",
      "level": "INFO",
      "service": "frontend",
      "event": "ui.action",
      "client_request_id": "cr_01HXYZ789",
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "page": "dashboard",
      "action": "click",
      "target": "data-testid=btn-submit",
      "client_platform": "web"
    }
  ]
}
