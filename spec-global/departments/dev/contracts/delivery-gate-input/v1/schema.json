{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/delivery-gate-input/v1",
  "title": "Delivery Gate Input",
  "description": "交付门禁 Agent 的输入契约",
  "type": "object",
  "required": ["gate_type", "project", "branch", "requester"],
  "properties": {
    "gate_type": {
      "type": "string",
      "enum": ["merge_gate", "release_gate", "hotfix_gate"],
      "description": "门禁类型"
    },
    "project": {
      "type": "string",
      "description": "项目名称"
    },
    "branch": {
      "type": "string",
      "description": "分支名称"
    },
    "requester": {
      "type": "string",
      "description": "请求人"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "请求时间"
    },
    "coverage_report": {
      "type": "object",
      "properties": {
        "core_modules": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "核心模块覆盖率 (%)"
        },
        "non_core_modules": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "非核心模块覆盖率 (%)"
        },
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "总体覆盖率 (%)"
        },
        "report_url": {
          "type": "string",
          "format": "uri",
          "description": "覆盖率报告链接"
        }
      },
      "description": "覆盖率报告"
    },
    "e2e_report": {
      "type": "object",
      "properties": {
        "total_tests": {
          "type": "integer",
          "description": "总测试数"
        },
        "passed": {
          "type": "integer",
          "description": "通过数"
        },
        "failed": {
          "type": "integer",
          "description": "失败数"
        },
        "skipped": {
          "type": "integer",
          "description": "跳过数"
        },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "通过率 (%)"
        },
        "critical_paths_covered": {
          "type": "boolean",
          "description": "关键路径是否全覆盖"
        },
        "report_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "E2E 测试报告"
    },
    "lint_report": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer",
          "description": "错误数"
        },
        "warnings": {
          "type": "integer",
          "description": "警告数"
        },
        "report_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "Lint 检查报告"
    },
    "security_report": {
      "type": "object",
      "properties": {
        "critical_vulnerabilities": {
          "type": "integer",
          "description": "Critical 漏洞数"
        },
        "high_vulnerabilities": {
          "type": "integer",
          "description": "High 漏洞数"
        },
        "medium_vulnerabilities": {
          "type": "integer",
          "description": "Medium 漏洞数"
        },
        "secrets_detected": {
          "type": "boolean",
          "description": "是否检测到泄露的密钥"
        },
        "report_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "安全扫描报告"
    },
    "code_review": {
      "type": "object",
      "properties": {
        "approvals": {
          "type": "integer",
          "description": "Approve 数量"
        },
        "blockers": {
          "type": "integer",
          "description": "阻塞项数量"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "审查者列表"
        }
      },
      "description": "Code Review 状态"
    },
    "test_case_coverage": {
      "type": "object",
      "properties": {
        "requirements_covered": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "需求覆盖率 (%)"
        },
        "contract_url": {
          "type": "string",
          "format": "uri",
          "description": "测试用例契约链接"
        }
      },
      "description": "测试用例覆盖"
    },
    "performance_report": {
      "type": "object",
      "properties": {
        "p99_latency_ms": {
          "type": "number",
          "description": "P99 延迟 (ms)"
        },
        "error_rate": {
          "type": "number",
          "description": "错误率 (%)"
        },
        "report_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "性能测试报告（Release Gate）"
    },
    "staging_verification": {
      "type": "object",
      "properties": {
        "e2e_passed": {
          "type": "boolean"
        },
        "migration_verified": {
          "type": "boolean"
        },
        "rollback_tested": {
          "type": "boolean"
        }
      },
      "description": "Staging 验证结果（Release Gate）"
    },
    "rollback_plan": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "plan_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "回滚方案"
    },
    "monitoring_ready": {
      "type": "boolean",
      "description": "监控告警是否已配置"
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "reason", "approved_by"],
        "properties": {
          "check": {
            "type": "string",
            "description": "豁免的检查项"
          },
          "reason": {
            "type": "string",
            "description": "豁免原因"
          },
          "mitigation": {
            "type": "string",
            "description": "缓解措施"
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "description": "修复截止日期"
          },
          "approved_by": {
            "type": "string",
            "description": "审批人"
          }
        }
      },
      "description": "豁免列表"
    }
  }
}
