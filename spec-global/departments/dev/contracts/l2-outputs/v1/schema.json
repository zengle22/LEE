{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lee.dev/schema/contracts/l2-outputs/v1",
  "title": "L2 Outputs Contract",
  "description": "L2 工作流输出契约，验证 L2 各阶段的输出汇总",
  "type": "object",
  "required": ["workflow_id", "phases"],
  "properties": {
    "workflow_id": {"type": "string", "description": "L2 工作流 ID"},
    "workflow_name": {"type": "string", "description": "L2 工作流名称"},
    "status": {"type": "string", "enum": ["in_progress", "completed", "failed", "cancelled"], "description": "工作流状态"},
    "phases": {
      "type": "array",
      "description": "各阶段输出",
      "items": {
        "type": "object",
        "required": ["phase_id", "status"],
        "properties": {
          "phase_id": {"type": "string", "description": "阶段 ID"},
          "phase_name": {"type": "string", "description": "阶段名称"},
          "status": {"type": "string", "enum": ["pending", "in_progress", "completed", "failed", "skipped"], "description": "阶段状态"},
          "outputs": {
            "type": "object",
            "description": "阶段输出文件",
            "properties": {
              "api_contract": {"type": "string", "description": "API 契约文件路径"},
              "fe_output": {"type": "string", "description": "前端输出文件路径"},
              "be_output": {"type": "string", "description": "后端输出文件路径"},
              "integration_report": {"type": "string", "description": "集成测试报告路径"},
              "smoke_report": {"type": "string", "description": "冒烟测试报告路径"}
            }
          },
          "l3_instances": {
            "type": "array",
            "description": "该阶段派发的 L3 实例",
            "items": {
              "type": "object",
              "properties": {
                "l3_id": {"type": "string"},
                "status": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "产出物清单",
      "required": ["required_artifacts"],
      "properties": {
        "required_artifacts": {
          "type": "array",
          "description": "必需的产出物",
          "items": {
            "type": "object",
            "required": ["path", "exists"],
            "properties": {
              "path": {"type": "string", "description": "产出物路径"},
              "exists": {"type": "boolean", "description": "文件是否存在"},
              "type": {"type": "string", "enum": ["contract", "document", "code", "patch", "test", "log"], "description": "产出物类型"}
            }
          }
        },
        "optional_artifacts": {
          "type": "array",
          "description": "可选的产出物",
          "items": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "执行摘要",
      "properties": {
        "total_phases": {"type": "integer", "minimum": 0},
        "completed_phases": {"type": "integer", "minimum": 0},
        "failed_phases": {"type": "integer", "minimum": 0},
        "total_l3_spawned": {"type": "integer", "minimum": 0}
      }
    },
    "started_at": {"type": "string", "format": "date-time", "description": "开始时间"},
    "completed_at": {"type": "string", "format": "date-time", "description": "完成时间"}
  }
}
