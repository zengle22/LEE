{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-gate-response-contract/v1/schema.json",
  "title": "Human Gate Response Contract",
  "description": "人类门禁响应格式契约 - 定义审批/审查响应的结构",
  "type": "object",
  "required": ["response_id", "request_id", "action", "responder", "responded_at"],
  "properties": {
    "response_id": {
      "type": "string",
      "pattern": "^HGRS-[0-9]{8}-[A-Z0-9]{6}$",
      "description": "响应唯一标识"
    },
    "request_id": {
      "type": "string",
      "pattern": "^HGR-[0-9]{8}-[A-Z0-9]{6}$",
      "description": "关联的请求 ID"
    },
    "action": {
      "type": "string",
      "description": "选择的操作 (对应 request 中的 available_actions)"
    },
    "responder": {
      "type": "object",
      "description": "响应者信息",
      "required": ["user_id"],
      "properties": {
        "user_id": {
          "type": "string",
          "description": "用户 ID"
        },
        "name": {
          "type": "string",
          "description": "用户名称"
        },
        "role": {
          "type": "string",
          "description": "用户角色"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "用户邮箱"
        }
      }
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "响应时间"
    },
    "checklist_responses": {
      "type": "array",
      "description": "审查清单响应",
      "items": {
        "type": "object",
        "required": ["checklist_id", "passed"],
        "properties": {
          "checklist_id": {
            "type": "string",
            "description": "清单项 ID"
          },
          "passed": {
            "type": "boolean",
            "description": "是否通过"
          },
          "comment": {
            "type": "string",
            "description": "备注"
          }
        }
      }
    },
    "comment": {
      "type": "string",
      "description": "响应备注/说明"
    },
    "conditions": {
      "type": "array",
      "description": "附加条件 (当 action 为 conditional_approve 时)",
      "items": {
        "type": "object",
        "required": ["condition"],
        "properties": {
          "condition": {
            "type": "string",
            "description": "条件描述"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "description": "截止时间"
          },
          "owner": {
            "type": "string",
            "description": "负责人"
          }
        }
      }
    },
    "issues_flagged": {
      "type": "array",
      "description": "标记的问题 (当 action 为 flag_issues 时)",
      "items": {
        "type": "object",
        "required": ["issue"],
        "properties": {
          "issue": {
            "type": "string",
            "description": "问题描述"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "严重程度"
          },
          "artifact_path": {
            "type": "string",
            "description": "相关产物路径"
          },
          "suggested_fix": {
            "type": "string",
            "description": "建议修复方案"
          }
        }
      }
    },
    "rejection_reason": {
      "type": "string",
      "description": "拒绝原因 (当 action 为 reject 时)"
    },
    "adjustment_request": {
      "type": "object",
      "description": "调整请求 (当 action 为 adjust 时)",
      "properties": {
        "changes_required": {
          "type": "array",
          "description": "需要的修改",
          "items": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "artifact_path": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": ["must", "should", "could"]
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "description": "附加说明"
        }
      }
    },
    "next_step": {
      "type": "string",
      "enum": ["continue", "retry_step", "fail", "rollback_to_phase", "continue_with_issues", "continue_with_conditions"],
      "description": "下一步行为"
    },
    "execution_directive": {
      "type": "object",
      "description": "执行指令",
      "properties": {
        "proceed": {
          "type": "boolean",
          "description": "是否继续执行"
        },
        "target_step": {
          "type": "string",
          "description": "跳转目标步骤 (如需要)"
        },
        "retry_from": {
          "type": "string",
          "description": "重试起点 (如需要)"
        },
        "additional_inputs": {
          "type": "object",
          "description": "附加输入参数",
          "additionalProperties": true
        }
      }
    },
    "signature": {
      "type": "object",
      "description": "数字签名 (可选)",
      "properties": {
        "algorithm": {
          "type": "string",
          "description": "签名算法"
        },
        "value": {
          "type": "string",
          "description": "签名值"
        },
        "certificate": {
          "type": "string",
          "description": "证书"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "扩展元数据",
      "additionalProperties": true
    }
  }
}
