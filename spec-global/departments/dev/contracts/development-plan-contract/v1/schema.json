{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-spec.example.com/contracts/development-plan-contract/v1/schema.json",
  "title": "Development Plan Contract",
  "description": "研发计划契约 - 定义完整的研发执行计划，包括 Phase 划分、Agent 编排、排期和交付标准",
  "type": "object",
  "required": [
    "plan_id",
    "version",
    "metadata",
    "inputs",
    "traceability",
    "role_assignments",
    "executable_tasks",
    "phases",
    "schedule",
    "entry_conditions",
    "delivery_standards"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[a-z0-9-]+$",
      "description": "计划唯一标识"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "计划版本号"
    },
    "metadata": {
      "type": "object",
      "required": ["project_name", "created_at", "created_by", "status"],
      "properties": {
        "project_name": {
          "type": "string",
          "description": "项目名称"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        },
        "created_by": {
          "type": "string",
          "description": "创建者"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "in_progress", "completed", "cancelled"],
          "description": "计划状态"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "description": "审批时间"
        },
        "approved_by": {
          "type": "string",
          "description": "审批人"
        }
      }
    },
    "inputs": {
      "type": "object",
      "description": "计划输入来源",
      "required": ["freeze_package"],
      "properties": {
        "freeze_package": {
          "type": "object",
          "required": ["id", "prd", "architecture"],
          "properties": {
            "id": {
              "type": "string",
              "description": "冻结包 ID"
            },
            "prd": {
              "type": "string",
              "description": "PRD 文件路径"
            },
            "architecture": {
              "type": "string",
              "description": "架构文档路径"
            },
            "ui_specs": {
              "type": "string",
              "description": "UI 规范路径"
            },
            "api_contracts": {
              "type": "string",
              "description": "API 契约路径"
            }
          }
        },
        "ui_prototype": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": ["figma", "sketch", "xd", "local"],
              "description": "原型来源"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "原型链接"
            },
            "screens": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string",
                    "enum": ["P0", "P1", "P2"]
                  }
                }
              }
            },
            "user_flows": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "用户流程列表"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "计划概要",
      "properties": {
        "total_phases": {
          "type": "integer",
          "minimum": 1,
          "description": "Phase 总数"
        },
        "total_duration_days": {
          "type": "number",
          "description": "预计总工期（天）"
        },
        "critical_path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "关键路径 Phase IDs"
        },
        "parallel_tracks": {
          "type": "integer",
          "description": "并行轨道数"
        },
        "buffer_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "description": "缓冲比例 %"
        }
      }
    },
    "traceability": {
      "type": "object",
      "description": "计划与上游 FEAT / AC 的追溯关系",
      "required": ["feat_ids", "acceptance_criteria_refs"],
      "properties": {
        "feat_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "acceptance_criteria_refs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "governing_adrs": {
          "type": "array",
          "description": "约束当前 TASK 计划的 ADR refs",
          "items": { "type": "string" }
        },
        "decision_refs": {
          "type": "array",
          "description": "本计划实际采用的 ADR / decision refs",
          "items": { "type": "string" }
        },
        "decision_constraints": {
          "type": "array",
          "description": "从 ADR 提炼出的硬约束摘要",
          "items": { "type": "string" }
        },
        "architecture_constraints": {
          "type": "array",
          "description": "对象归属、依赖边界、拆分规则等架构约束",
          "items": { "type": "string" }
        },
        "process_constraints": {
          "type": "array",
          "description": "freeze、review、handoff、evidence 等流程约束",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "role_assignments": {
      "type": "array",
      "description": "实施计划中的责任分工",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "owner"],
        "properties": {
          "role": { "type": "string" },
          "owner": { "type": "string" },
          "scope": { "type": "string" }
        }
      }
    },
    "executable_tasks": {
      "type": "array",
      "description": "按 FEAT 派生的可执行任务清单",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "feat_id", "lane", "owner_role", "acceptance_criteria_refs"],
        "properties": {
          "task_id": { "type": "string" },
          "feat_id": { "type": "string" },
          "lane": {
            "type": "string",
            "enum": ["frontend", "backend", "integration", "qa"]
          },
          "owner_role": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance_criteria_refs": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "definition_of_done": { "type": "string" },
          "decision_refs": {
            "type": "array",
            "description": "该任务直接引用的治理决策",
            "items": { "type": "string" }
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "description": "Phase 列表",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Phase 间依赖关系",
      "properties": {
        "graph": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "依赖图 {phase_id: [dependent_phase_ids]}"
        },
        "critical_path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "关键路径"
        }
      }
    },
    "schedule": {
      "type": "object",
      "description": "排期计划",
      "required": ["start_date", "end_date", "milestones"],
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "计划开始日期"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "计划结束日期"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "date", "deliverables"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "deliverables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "phase_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "phase_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase_id", "start_date", "end_date"],
            "properties": {
              "phase_id": {
                "type": "string"
              },
              "start_date": {
                "type": "string",
                "format": "date"
              },
              "end_date": {
                "type": "string",
                "format": "date"
              },
              "track": {
                "type": "integer",
                "description": "并行轨道编号"
              }
            }
          }
        }
      }
    },
    "entry_conditions": {
      "type": "array",
      "description": "开工前置条件",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "delivery_standards": {
      "type": "object",
      "description": "全局交付标准",
      "properties": {
        "code_quality": {
          "type": "object",
          "properties": {
            "lint_pass": {
              "type": "boolean",
              "default": true
            },
            "type_check_pass": {
              "type": "boolean",
              "default": true
            },
            "no_console_logs": {
              "type": "boolean",
              "default": true
            },
            "max_complexity": {
              "type": "integer",
              "default": 10
            }
          }
        },
        "test_coverage": {
          "type": "object",
          "properties": {
            "unit_threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 80
            },
            "integration_threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 70
            },
            "e2e_threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 60
            }
          }
        },
        "review_criteria": {
          "type": "object",
          "properties": {
            "no_blockers": {
              "type": "boolean",
              "default": true
            },
            "max_majors": {
              "type": "integer",
              "default": 2
            },
            "required_approvals": {
              "type": "integer",
              "default": 1
            }
          }
        },
        "documentation": {
          "type": "object",
          "properties": {
            "api_docs_required": {
              "type": "boolean",
              "default": true
            },
            "readme_updated": {
              "type": "boolean",
              "default": true
            },
            "changelog_updated": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "description": "风险评估",
      "items": {
        "type": "object",
        "required": ["id", "description", "probability", "impact"],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "probability": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "impact": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "mitigation": {
            "type": "string"
          },
          "contingency_days": {
            "type": "number"
          },
          "affected_phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "资源需求",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              },
              "allocation": {
                "type": "string",
                "description": "分配说明"
              }
            }
          }
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "phase_id",
        "name",
        "type",
        "size",
        "boundary",
        "agent_orchestration",
        "delivery_criteria"
      ],
      "properties": {
        "phase_id": {
          "type": "string",
          "pattern": "^phase-[a-z0-9-]+$",
          "description": "Phase 唯一标识"
        },
        "name": {
          "type": "string",
          "description": "Phase 名称"
        },
        "description": {
          "type": "string",
          "description": "Phase 描述"
        },
        "type": {
          "type": "string",
          "enum": ["foundation", "feature", "integration", "polish", "spike"],
          "description": "Phase 类型"
        },
        "size": {
          "type": "string",
          "enum": ["S", "M", "L", "XL"],
          "description": "Phase 规模"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2"],
          "description": "优先级"
        },
        "estimated_days": {
          "type": "number",
          "minimum": 0.5,
          "description": "预计工期（天）"
        },
        "boundary": {
          "type": "object",
          "description": "Phase 边界定义",
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["code", "test", "doc", "config", "artifact"]
                  }
                }
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "依赖的 Phase IDs"
            },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["api", "event", "component", "service"]
                  },
                  "contract": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "agent_orchestration": {
          "type": "array",
          "description": "Agent 编排序列",
          "items": {
            "type": "object",
            "required": ["step", "agent_id", "name"],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "agent_id": {
                "type": "string",
                "description": "Agent ID"
              },
              "name": {
                "type": "string",
                "description": "步骤名称"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimated_hours": {
                "type": "number"
              },
              "retry_on_failure": {
                "type": "boolean",
                "default": true
              },
              "max_retries": {
                "type": "integer",
                "default": 3
              },
              "human_gate": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "delivery_criteria": {
          "type": "array",
          "description": "交付标准",
          "items": {
            "type": "object",
            "required": ["id", "description", "verification"],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "verification": {
                "type": "string",
                "enum": ["automated", "manual", "review"],
                "description": "验证方式"
              },
              "command": {
                "type": "string",
                "description": "自动化验证命令"
              },
              "threshold": {
                "type": "object",
                "description": "阈值配置"
              }
            }
          }
        },
        "quality_gates": {
          "type": "object",
          "description": "Phase 级质量门禁覆盖",
          "properties": {
            "unit_test": {
              "type": "object",
              "properties": {
                "coverage_threshold": {
                  "type": "integer"
                },
                "pass_rate": {
                  "type": "integer",
                  "default": 100
                }
              }
            },
            "code_review": {
              "type": "object",
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "approvers": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "关联的风险 IDs"
        }
      }
    }
  }
}
