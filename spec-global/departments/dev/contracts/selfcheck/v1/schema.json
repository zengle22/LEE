{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/development/selfcheck/v1",
  "title": "Development Selfcheck Report Schema",
  "description": "开发自检报告契约 - 返修完成后的强制自检",
  "type": "object",
  "required": [
    "selfcheck_id",
    "retest_round",
    "bugs_addressed",
    "unit_test",
    "local_smoke",
    "overall_status",
    "executed_at",
    "executed_by"
  ],
  "properties": {
    "selfcheck_id": {
      "type": "string",
      "pattern": "^SELFCHECK-[0-9]{4}-[0-9]{4}$",
      "description": "自检报告 ID"
    },
    "retest_round": {
      "type": "integer",
      "minimum": 1,
      "description": "返修轮次"
    },
    "bugs_addressed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^BUG-[0-9]{4}-[0-9]{4}$"
      },
      "description": "本次修复的 Bug ID 列表"
    },
    "unit_test": {
      "type": "object",
      "required": ["passed", "total", "pass_rate", "status"],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string",
          "enum": ["PASSED", "FAILED"],
          "description": "必须为 PASSED"
        },
        "affected_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_name": { "type": "string" },
              "status": { "type": "string" },
              "duration_ms": { "type": "integer" }
            }
          }
        },
        "new_tests_added": {
          "type": "integer",
          "minimum": 0
        },
        "report_url": {
          "type": "string"
        }
      }
    },
    "local_smoke": {
      "type": "object",
      "required": ["passed", "total", "status"],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": ["PASSED", "FAILED"]
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": { "type": "string" },
              "name": { "type": "string" },
              "status": { "type": "string", "enum": ["PASSED", "FAILED"] },
              "notes": { "type": "string" }
            }
          }
        },
        "environment": {
          "type": "string",
          "description": "测试环境（local/docker等）"
        }
      }
    },
    "regression_tests": {
      "type": "object",
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0,
          "description": "新增回归测试数量"
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_name": { "type": "string" },
              "bug_id": { "type": "string" },
              "status": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["PASSED", "PASSED_WITH_WARNINGS", "FAILED"],
      "description": "总体状态"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "警告信息"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "阻塞问题"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_by": {
      "type": "string"
    },
    "execution_duration_minutes": {
      "type": "integer"
    }
  }
}
