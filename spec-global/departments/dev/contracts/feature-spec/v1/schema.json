{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev/feature-spec/v1/schema.json",
  "title": "Feature Spec",
  "description": "Feature 需求概要与验收标准",
  "type": "object",
  "required": ["id", "title", "description", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "acceptance_criteria": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "spec_path": {"type": "string"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
