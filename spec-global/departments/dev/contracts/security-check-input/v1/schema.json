{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/security-check-input/v1",
  "title": "Security Check Input",
  "description": "SecOps Agent 的输入契约",
  "type": "object",
  "required": ["repository", "branch", "check_types"],
  "properties": {
    "repository": {
      "type": "string",
      "description": "代码仓库名称"
    },
    "branch": {
      "type": "string",
      "description": "分支名称"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Commit SHA"
    },
    "check_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["sast", "sca", "secrets", "container", "infrastructure"]
      },
      "minItems": 1,
      "description": "要执行的检查类型"
    },
    "scan_scope": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "扫描路径（为空则全量）"
        },
        "exclude_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "排除路径"
        }
      },
      "description": "扫描范围"
    },
    "docker_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "要扫描的 Docker 镜像列表"
    },
    "severity_threshold": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "default": "high",
      "description": "报告阈值（只报告此级别及以上）"
    },
    "blocking_severities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["critical", "high"]
      },
      "default": ["critical", "high"],
      "description": "阻断级别"
    },
    "existing_exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["vulnerability_id", "reason", "approved_by", "expires"],
        "properties": {
          "vulnerability_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "expires": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "已有的豁免列表"
    }
  }
}
