{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/security-report-output/v1",
  "title": "Security Report Output",
  "description": "SecOps Agent 的输出契约",
  "type": "object",
  "required": ["scan_id", "timestamp", "verdict", "summary"],
  "properties": {
    "scan_id": {
      "type": "string",
      "description": "扫描ID"
    },
    "repository": {
      "type": "string",
      "description": "代码仓库"
    },
    "branch": {
      "type": "string",
      "description": "分支"
    },
    "commit_sha": {
      "type": "string",
      "description": "Commit SHA"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "扫描时间"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "WARN"],
      "description": "总体判定"
    },
    "summary": {
      "type": "object",
      "required": ["total_issues"],
      "properties": {
        "total_issues": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer"
            },
            "high": {
              "type": "integer"
            },
            "medium": {
              "type": "integer"
            },
            "low": {
              "type": "integer"
            }
          }
        },
        "by_category": {
          "type": "object",
          "properties": {
            "sast": {
              "type": "integer"
            },
            "sca": {
              "type": "integer"
            },
            "secrets": {
              "type": "integer"
            },
            "container": {
              "type": "integer"
            }
          }
        }
      },
      "description": "摘要统计"
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SecurityIssue"
      },
      "description": "阻塞项（必须修复）"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SecurityIssue"
      },
      "description": "警告项（应当修复）"
    },
    "exemptions_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vulnerability_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "expires": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "已应用的豁免"
    },
    "infrastructure_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["least_privilege", "network_isolation", "encryption", "audit_logs"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "not_applicable"]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "基础设施安全检查"
    },
    "scan_details": {
      "type": "object",
      "properties": {
        "tools_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_seconds": {
          "type": "integer"
        },
        "files_scanned": {
          "type": "integer"
        },
        "images_scanned": {
          "type": "integer"
        }
      },
      "description": "扫描详情"
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "下一步行动建议"
    }
  },
  "$defs": {
    "SecurityIssue": {
      "type": "object",
      "required": ["id", "category", "severity", "title"],
      "properties": {
        "id": {
          "type": "string",
          "description": "漏洞ID (CVE 或内部ID)"
        },
        "category": {
          "type": "string",
          "enum": ["sast", "sca", "secrets", "container", "infrastructure"],
          "description": "类别"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"],
          "description": "严重程度"
        },
        "title": {
          "type": "string",
          "description": "问题标题"
        },
        "description": {
          "type": "string",
          "description": "问题描述"
        },
        "location": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            },
            "package": {
              "type": "string"
            },
            "image": {
              "type": "string"
            }
          },
          "description": "问题位置"
        },
        "fix_suggestion": {
          "type": "string",
          "description": "修复建议"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "参考链接"
        },
        "cvss_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "CVSS 评分"
        }
      }
    }
  }
}
