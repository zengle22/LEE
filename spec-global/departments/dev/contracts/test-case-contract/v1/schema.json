{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/test-case-contract/v1",
  "title": "Test Case Contract",
  "description": "QA 工程师输出的测试用例契约，作为 SDET 的输入",
  "type": "object",
  "required": ["version", "module", "coverage_summary", "coverage_matrix", "test_cases"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "契约版本号 (语义化版本)"
    },
    "module": {
      "type": "string",
      "description": "模块名称"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "最后更新日期"
    },
    "coverage_summary": {
      "type": "object",
      "required": ["total_requirements", "covered_requirements", "coverage_rate"],
      "properties": {
        "total_requirements": {
          "type": "integer",
          "minimum": 0,
          "description": "需求总数"
        },
        "covered_requirements": {
          "type": "integer",
          "minimum": 0,
          "description": "已覆盖需求数"
        },
        "coverage_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "覆盖率百分比"
        }
      }
    },
    "coverage_matrix": {
      "type": "array",
      "description": "需求到用例的追溯矩阵",
      "items": {
        "type": "object",
        "required": ["requirement_id", "requirement_description", "test_case_ids", "status"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[A-Z]+-\\d+$",
            "description": "需求ID"
          },
          "requirement_description": {
            "type": "string",
            "description": "需求描述"
          },
          "test_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TC-[A-Z]+-\\d+$"
            },
            "description": "关联的测试用例ID列表"
          },
          "status": {
            "type": "string",
            "enum": ["covered", "partial", "not_covered"],
            "description": "覆盖状态"
          }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "description": "测试用例列表",
      "items": {
        "$ref": "#/$defs/TestCase"
      }
    }
  },
  "$defs": {
    "TestCase": {
      "type": "object",
      "required": ["id", "title", "requirement_id", "priority", "type", "steps", "acceptance_criteria"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-[A-Z]+-\\d+$",
          "description": "测试用例ID，格式: TC-{MODULE}-{NUMBER}"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "description": "用例标题"
        },
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[A-Z]+-\\d+$",
          "description": "关联的需求ID"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2"],
          "description": "优先级: P0-关键路径, P1-重要, P2-一般"
        },
        "type": {
          "type": "string",
          "enum": ["functional", "integration", "e2e", "performance", "security"],
          "description": "测试类型"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["regression", "smoke", "critical-path", "happy-path", "edge-case", "error-case"]
          },
          "description": "测试标签"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "前置条件"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step_number", "action", "expected_result"],
            "properties": {
              "step_number": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string",
                "description": "操作动作"
              },
              "expected_result": {
                "type": "string",
                "description": "期望结果"
              },
              "test_data": {
                "type": "string",
                "description": "测试数据"
              }
            }
          },
          "description": "测试步骤"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "可量化的验收标准"
        },
        "test_data_spec": {
          "type": "object",
          "description": "测试数据规格",
          "properties": {
            "valid_data": {
              "type": "object",
              "description": "有效数据示例"
            },
            "invalid_data": {
              "type": "object",
              "description": "无效数据示例"
            },
            "boundary_data": {
              "type": "object",
              "description": "边界数据示例"
            }
          }
        }
      }
    }
  }
}
