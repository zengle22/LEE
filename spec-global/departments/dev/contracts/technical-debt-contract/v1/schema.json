{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/development/technical-debt/v1",
  "title": "Technical Debt Contract",
  "description": "技术债务契约 - 记录低优先级问题与后续处理计划",
  "type": "object",
  "required": ["debt_id", "bug_id", "items", "created_at"],
  "properties": {
    "debt_id": {
      "type": "string",
      "pattern": "^DEBT-[0-9]{4}-[0-9]{4}$"
    },
    "bug_id": {
      "type": "string",
      "pattern": "^BUG-[0-9]{4}-[0-9]{4}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "priority"],
        "properties": {
          "title": { "type": "string" },
          "priority": { "type": "string", "enum": ["P3", "LOW"] },
          "source": { "type": "string", "enum": ["code_review", "verification", "analysis", "other"] },
          "description": { "type": "string" },
          "suggested_fix": { "type": "string" },
          "owner": { "type": "string" },
          "target_version": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" }
  }
}
