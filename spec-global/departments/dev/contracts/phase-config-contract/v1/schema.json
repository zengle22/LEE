{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-spec.example.com/contracts/phase-config-contract/v1/schema.json",
  "title": "Phase Configuration Schema",
  "description": "Configuration for generating a phase workflow from template. Only non-structural overrides are allowed. Structural elements (steps, dependencies, gates) come from the template and cannot be modified.",
  "type": "object",
  "required": ["id", "name", "phase_dir"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Phase identifier (e.g., 'phase11-logging', 'phase-user-auth')"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable phase name (e.g., '日志体系改造')"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Multi-line phase description explaining the purpose and scope"
    },
    "phase_dir": {
      "type": "string",
      "description": "Phase directory path relative to project root (e.g., 'project/myproject/dev/phase11')"
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3}$",
      "default": "CHG-001",
      "description": "OpenSpec change ID for tracking (e.g., 'CHG-001')"
    },
    "project_dir": {
      "type": "string",
      "description": "Project root directory for knowledge merge (auto-derived from phase_dir if not specified)"
    },
    "step_descriptions": {
      "type": "object",
      "description": "Override descriptions for specific steps. Keys must match step IDs from template.",
      "patternProperties": {
        "^p[0-9]+_[a-z_]+$": {
          "type": "string",
          "maxLength": 1000,
          "description": "Step description override"
        }
      },
      "additionalProperties": false
    },
    "step_path_overrides": {
      "type": "object",
      "description": "Override input/output paths for specific steps. Cannot add or remove steps.",
      "patternProperties": {
        "^p[0-9]+_[a-z_]+$": {
          "type": "object",
          "properties": {
            "inputs": {
              "type": "object",
              "description": "Input path overrides",
              "additionalProperties": { "type": "string" }
            },
            "outputs": {
              "type": "array",
              "description": "Output path overrides",
              "items": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" }
                },
                "required": ["path"]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gate_descriptions": {
      "type": "object",
      "description": "Override descriptions for human gates. Cannot add or remove gates.",
      "patternProperties": {
        "^h[0-9]+_[a-z_]+$": {
          "type": "string",
          "maxLength": 500,
          "description": "Gate description override"
        }
      },
      "additionalProperties": false
    },
    "quality_overrides": {
      "type": "object",
      "description": "Override quality thresholds (cannot lower below minimums)",
      "properties": {
        "coverage_threshold": {
          "type": "integer",
          "minimum": 50,
          "maximum": 100,
          "description": "Code coverage threshold percentage"
        },
        "pass_rate": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100,
          "description": "Test pass rate threshold percentage"
        }
      },
      "additionalProperties": true
    },
    "output_paths": {
      "type": "object",
      "description": "Path mappings for workflow outputs",
      "properties": {
        "requirements": { "type": "string" },
        "test_contracts": { "type": "string" },
        "proposals": { "type": "string" },
        "implementation": { "type": "string" },
        "tests": { "type": "string" },
        "review": { "type": "string" },
        "retrospective": { "type": "string" },
        "knowledge": { "type": "string" },
        "acceptance": { "type": "string" },
        "handover": { "type": "string" }
      },
      "additionalProperties": true
    },
    "deliverables": {
      "type": "array",
      "description": "List of expected deliverables for this phase",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "standards": {
      "type": "array",
      "description": "References to standards this phase must comply with",
      "items": {
        "type": "object",
        "required": ["ref", "path"],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Standard reference ID (e.g., 'standard.dev.observability.logging')"
          },
          "path": {
            "type": "string",
            "description": "Path to standard specification file"
          },
          "mandatory": {
            "type": "boolean",
            "default": true,
            "description": "Whether compliance is mandatory"
          },
          "artifacts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Related artifact paths"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for tracking and audit",
      "properties": {
        "phase_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Phase number in project sequence"
        },
        "track": {
          "type": "string",
          "enum": ["backend", "frontend", "cross-cutting", "ai", "devops"],
          "description": "Development track"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Phase priority"
        },
        "reason": {
          "type": "string",
          "description": "Reason for this phase"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Phase dependencies"
        },
        "created_by": { "type": "string" },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  }
}
