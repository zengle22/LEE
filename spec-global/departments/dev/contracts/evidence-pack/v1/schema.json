{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lee.local/contracts/dev-evidence-pack/v1/schema.json",
  "title": "Dev Evidence Pack Contract",
  "description": "Dev 部门 Evidence Pack 契约，作为证据轴正式收口对象。",
  "type": "object",
  "required": [
    "formal_ssot_id",
    "source_refs",
    "governing_adrs",
    "delivery_outputs",
    "verification_results",
    "evidence_types"
  ],
  "properties": {
    "formal_ssot_id": {
      "type": "string",
      "minLength": 3
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "governing_adrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9A-Z_-]+$"
      }
    },
    "delivery_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "ref"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 2 },
          "artifact_type": {
            "type": "string",
            "enum": ["contract", "backend", "frontend", "integration", "evidence"]
          },
          "ref": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    },
    "verification_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["result_type", "status", "ref"],
        "properties": {
          "result_type": {
            "type": "string",
            "enum": ["test_report", "integration_report", "review_record", "deployment_record"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "warning"]
          },
          "ref": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "code_diff",
          "test_report",
          "review_record",
          "deployment_record",
          "integration_report"
        ]
      },
      "allOf": [
        { "contains": { "const": "code_diff" } },
        { "contains": { "const": "test_report" } },
        { "contains": { "const": "review_record" } },
        { "contains": { "const": "deployment_record" } },
        { "contains": { "const": "integration_report" } }
      ]
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_ref", "to_ref", "trace_kind"],
        "properties": {
          "from_ref": { "type": "string", "minLength": 3 },
          "to_ref": { "type": "string", "minLength": 3 },
          "trace_kind": {
            "type": "string",
            "enum": ["upstream_source", "delivery_output", "verification_output"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
