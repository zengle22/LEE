{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev/code-diff/v1/schema.json",
  "title": "Code Diff",
  "description": "代码变更补丁与摘要",
  "type": "object",
  "required": ["summary", "patch"],
  "properties": {
    "summary": {"type": "string"},
    "patch": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_type"],
        "properties": {
          "path": {"type": "string"},
          "change_type": {"type": "string", "enum": ["added", "modified", "deleted"]}
        }
      }
    }
  }
}
