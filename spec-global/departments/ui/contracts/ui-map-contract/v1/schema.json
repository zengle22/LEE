{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-map-contract/v1/schema.json",
  "title": "UI Map Contract",
  "description": "UI 全局索引契约 - 页面/路由/权限/埋点总索引，用于门禁验证",
  "type": "object",
  "required": ["$schema", "version", "pages"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "ui-map-contract/v1"
    },
    "version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "figmaProject": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PageEntry"
      },
      "description": "页面清单"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ComponentEntry"
      },
      "description": "组件清单"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RouteEntry"
      },
      "description": "路由配置"
    },
    "quality": {
      "$ref": "#/definitions/QualityConfig",
      "description": "质量要求配置"
    },
    "coverage": {
      "$ref": "#/definitions/CoverageReport",
      "description": "覆盖率报告"
    }
  },
  "definitions": {
    "PageEntry": {
      "type": "object",
      "required": ["id", "contracts"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^page\\.[a-z_]+$"
        },
        "name": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "figma": {
          "type": "string",
          "description": "Figma 设计稿链接"
        },
        "contracts": {
          "type": "object",
          "required": ["page"],
          "properties": {
            "page": {
              "type": "string",
              "description": "页面契约文件路径"
            },
            "api": {
              "type": "array",
              "items": { "type": "string" },
              "description": "关联的 API 契约"
            }
          }
        },
        "requiredStates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["default", "loading", "empty", "error", "success"]
          },
          "default": ["default", "loading", "empty", "error"]
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2"],
          "description": "页面优先级"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "review", "approved", "implemented", "tested"],
          "description": "页面状态"
        },
        "owners": {
          "type": "array",
          "items": { "type": "string" },
          "description": "负责人列表"
        }
      }
    },
    "ComponentEntry": {
      "type": "object",
      "required": ["id", "contract"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^component\\.[a-z_]+$"
        },
        "name": {
          "type": "string"
        },
        "figma": {
          "type": "string"
        },
        "contract": {
          "type": "string",
          "description": "组件契约文件路径"
        },
        "category": {
          "type": "string",
          "enum": ["basic", "form", "data-display", "feedback", "navigation", "layout", "business"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "review", "approved", "implemented", "tested"]
        }
      }
    },
    "RouteEntry": {
      "type": "object",
      "required": ["path", "pageId"],
      "properties": {
        "path": {
          "type": "string"
        },
        "pageId": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "guards": {
          "type": "array",
          "items": { "type": "string" },
          "description": "路由守卫"
        },
        "meta": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "requiresAuth": { "type": "boolean" },
            "layout": { "type": "string" }
          }
        }
      }
    },
    "QualityConfig": {
      "type": "object",
      "properties": {
        "requireA11y": {
          "type": "boolean",
          "default": true,
          "description": "是否要求可访问性"
        },
        "requireTracking": {
          "type": "boolean",
          "default": true,
          "description": "是否要求埋点"
        },
        "requireTokens": {
          "type": "boolean",
          "default": true,
          "description": "是否要求使用设计 token"
        },
        "requireFigma": {
          "type": "boolean",
          "default": true,
          "description": "是否要求 Figma 链接"
        },
        "requiredStates": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["default", "loading", "empty", "error"],
          "description": "必须覆盖的状态"
        },
        "testCoverage": {
          "type": "object",
          "properties": {
            "unit": { "type": "number", "minimum": 0, "maximum": 100 },
            "e2e": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "CoverageReport": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pages": {
          "type": "object",
          "properties": {
            "total": { "type": "number" },
            "withContract": { "type": "number" },
            "withFigma": { "type": "number" },
            "withTests": { "type": "number" }
          }
        },
        "components": {
          "type": "object",
          "properties": {
            "total": { "type": "number" },
            "withContract": { "type": "number" },
            "withStorybook": { "type": "number" }
          }
        },
        "states": {
          "type": "object",
          "properties": {
            "covered": { "type": "number" },
            "missing": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
