{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-page-contract/v1/schema.json",
  "title": "UI Page Contract",
  "description": "页面契约规范 v1.1 - 定义页面应该长什么样、有哪些状态、有哪些交互、哪些校验。新增：用户流关联、前置条件、显隐规则、恢复路径",
  "type": "object",
  "required": ["id", "route", "states"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^page\\.[a-z_]+$",
      "description": "页面唯一标识符，格式: page.{name}"
    },
    "route": {
      "type": "string",
      "description": "路由路径，支持参数如 /user/:id"
    },
    "title": {
      "type": "string",
      "description": "页面标题"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["guest", "user", "admin", "super_admin"]
      },
      "description": "可访问该页面的角色列表"
    },
    "figma": {
      "type": "string",
      "description": "Figma 设计稿链接"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/PageState"
      },
      "description": "页面状态列表，必须包含 default/loading/empty/error"
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Interaction"
      },
      "description": "页面交互定义"
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ValidationRule"
      },
      "description": "表单校验规则"
    },
    "tracking": {
      "$ref": "#/definitions/Tracking",
      "description": "埋点配置"
    },
    "a11y": {
      "$ref": "#/definitions/A11yConfig",
      "description": "可访问性配置"
    },
    "seo": {
      "$ref": "#/definitions/SeoConfig",
      "description": "SEO 配置"
    },
    "flow_binding": {
      "$ref": "#/definitions/FlowBinding",
      "description": "v1.1 新增：用户流关联配置"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Precondition"
      },
      "description": "v1.1 新增：页面的前置条件列表"
    },
    "visibility_rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/VisibilityRule"
      },
      "description": "v1.1 新增：页面/组件的显隐规则"
    },
    "disabled_rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DisabledRule"
      },
      "description": "v1.1 新增：页面/组件的禁用规则"
    },
    "recovery_paths": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RecoveryPath"
      },
      "description": "v1.1 新增：错误恢复路径定义"
    }
  },
  "definitions": {
    "PageState": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["default", "loading", "empty", "error", "success", "partial"],
          "description": "状态名称"
        },
        "pattern": {
          "type": "string",
          "enum": ["skeleton", "spinner", "placeholder", "custom"],
          "description": "加载态展示模式"
        },
        "messageKey": {
          "type": "string",
          "description": "空状态或错误状态的文案 key"
        },
        "errorCodes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "该状态对应的错误码列表"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentRef"
          },
          "description": "该状态下的组件列表"
        }
      }
    },
    "ComponentRef": {
      "type": "object",
      "required": ["ref", "id"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^component\\.[a-z_]+$",
          "description": "组件契约引用"
        },
        "id": {
          "type": "string",
          "description": "组件实例 ID"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "是否必须存在"
        },
        "props": {
          "type": "object",
          "description": "组件属性配置"
        },
        "slot": {
          "type": "string",
          "description": "组件插槽位置"
        }
      }
    },
    "Interaction": {
      "type": "object",
      "required": ["id", "trigger"],
      "properties": {
        "id": {
          "type": "string",
          "description": "交互唯一标识"
        },
        "trigger": {
          "type": "string",
          "description": "触发条件，如 click(button_id)"
        },
        "api": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]
            },
            "endpoint": {
              "type": "string"
            },
            "contractRef": {
              "type": "string",
              "description": "API 契约引用"
            }
          }
        },
        "navigation": {
          "type": "object",
          "properties": {
            "to": { "type": "string" },
            "params": { "type": "object" }
          }
        },
        "success": {
          "type": "object",
          "properties": {
            "toastKey": { "type": "string" },
            "redirect": { "type": "string" },
            "updateState": { "type": "string" }
          }
        },
        "failure": {
          "type": "object",
          "properties": {
            "showInlineError": { "type": "boolean" },
            "toastKey": { "type": "string" },
            "fallbackState": { "type": "string" }
          }
        }
      }
    },
    "ValidationRule": {
      "type": "object",
      "required": ["field", "rules"],
      "properties": {
        "field": {
          "type": "string",
          "description": "字段名"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["required", "minLength", "maxLength", "min", "max", "pattern", "email", "phone", "custom"]
              },
              "value": {},
              "messageKey": { "type": "string" }
            }
          }
        }
      }
    },
    "Tracking": {
      "type": "object",
      "properties": {
        "exposure": {
          "type": "array",
          "items": { "type": "string" },
          "description": "页面曝光事件列表"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event", "trigger"],
            "properties": {
              "event": { "type": "string" },
              "trigger": { "type": "string" },
              "params": { "type": "object" }
            }
          }
        }
      }
    },
    "A11yConfig": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "default": true
        },
        "focusOrder": {
          "type": "array",
          "items": { "type": "string" },
          "description": "焦点顺序"
        },
        "landmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "skipLinks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SeoConfig": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canonical": { "type": "string" },
        "noindex": { "type": "boolean" }
      }
    },
    "FlowBinding": {
      "type": "object",
      "description": "v1.1 新增：页面与用户流的关联",
      "properties": {
        "flow_ref": {
          "type": "string",
          "pattern": "^flow\\.[a-z_]+$",
          "description": "关联的用户流 ID"
        },
        "step_id": {
          "type": "string",
          "description": "该页面在用户流中对应的步骤 ID"
        },
        "is_entry_page": {
          "type": "boolean",
          "default": false,
          "description": "是否是用户流的入口页面"
        },
        "is_completion_page": {
          "type": "boolean",
          "default": false,
          "description": "是否是用户流的完成页面"
        }
      }
    },
    "Precondition": {
      "type": "object",
      "description": "v1.1 新增：前置条件定义（在入口处解决）",
      "required": ["id", "condition", "not_met_action"],
      "properties": {
        "id": {
          "type": "string",
          "description": "前置条件唯一标识"
        },
        "condition": {
          "type": "string",
          "description": "条件表达式"
        },
        "not_met_action": {
          "type": "string",
          "enum": ["hide", "disable", "redirect", "show_guide"],
          "description": "条件不满足时的处理方式"
        },
        "message_key": {
          "type": "string",
          "description": "不满足时的提示文案 key"
        },
        "guide_to": {
          "type": "string",
          "description": "引导跳转目标（当 not_met_action 为 redirect 或 show_guide 时）"
        },
        "target": {
          "type": "string",
          "description": "作用目标（page 或 component_id）"
        }
      }
    },
    "VisibilityRule": {
      "type": "object",
      "description": "v1.1 新增：显隐规则（条件不满足时隐藏入口）",
      "required": ["target", "condition"],
      "properties": {
        "target": {
          "type": "string",
          "description": "作用目标（component_id 或 'page'）"
        },
        "condition": {
          "type": "string",
          "description": "可见条件表达式（true 时可见）"
        },
        "hidden_reason": {
          "type": "string",
          "description": "隐藏原因（用于调试和文档）"
        }
      }
    },
    "DisabledRule": {
      "type": "object",
      "description": "v1.1 新增：禁用规则（条件不满足时灰掉 + 文案）",
      "required": ["target", "condition", "message_key"],
      "properties": {
        "target": {
          "type": "string",
          "description": "作用目标（component_id）"
        },
        "condition": {
          "type": "string",
          "description": "禁用条件表达式（true 时禁用）"
        },
        "message_key": {
          "type": "string",
          "description": "禁用时显示的文案 key"
        },
        "tooltip": {
          "type": "boolean",
          "default": true,
          "description": "是否显示 tooltip 说明"
        }
      }
    },
    "RecoveryPath": {
      "type": "object",
      "description": "v1.1 新增：错误恢复路径定义",
      "required": ["error_state", "recovery_action"],
      "properties": {
        "error_state": {
          "type": "string",
          "description": "错误状态名称或错误码"
        },
        "recovery_action": {
          "type": "string",
          "enum": ["retry", "back_to_previous", "redirect", "show_help", "contact_support"],
          "description": "恢复动作"
        },
        "target": {
          "type": "string",
          "description": "恢复目标（页面或步骤）"
        },
        "message_key": {
          "type": "string",
          "description": "恢复提示文案 key"
        },
        "cta_key": {
          "type": "string",
          "description": "恢复按钮文案 key"
        },
        "max_retries": {
          "type": "integer",
          "default": 3,
          "description": "最大重试次数"
        }
      }
    }
  }
}
