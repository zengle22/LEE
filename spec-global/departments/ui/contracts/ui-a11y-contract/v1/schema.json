{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-a11y-contract/v1/schema.json",
  "title": "UI A11y Rules Contract",
  "description": "可访问性规则契约 - 定义 UI 可访问性门禁标准",
  "type": "object",
  "required": ["$schema", "version", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "ui-a11y-contract/v1"
    },
    "version": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": ["A", "AA", "AAA"],
      "default": "AA",
      "description": "WCAG 合规级别"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/A11yRule"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/A11yException"
      },
      "description": "规则例外配置"
    },
    "testing": {
      "$ref": "#/definitions/A11yTestingConfig"
    }
  },
  "definitions": {
    "A11yRule": {
      "type": "object",
      "required": ["id", "name", "category", "severity"],
      "properties": {
        "id": {
          "type": "string",
          "description": "规则唯一标识"
        },
        "name": {
          "type": "string",
          "description": "规则名称"
        },
        "wcag": {
          "type": "string",
          "description": "WCAG 标准引用，如 1.1.1"
        },
        "category": {
          "type": "string",
          "enum": ["perceivable", "operable", "understandable", "robust"],
          "description": "WCAG 四大原则分类"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "serious", "moderate", "minor"],
          "description": "严重程度"
        },
        "description": {
          "type": "string"
        },
        "check": {
          "type": "string",
          "description": "检查方法或 axe-core 规则 ID"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["page", "component", "global"]
          }
        }
      }
    },
    "A11yException": {
      "type": "object",
      "required": ["ruleId", "target", "reason"],
      "properties": {
        "ruleId": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "description": "豁免目标（页面 ID 或组件 ID）"
        },
        "reason": {
          "type": "string",
          "description": "豁免原因"
        },
        "expiry": {
          "type": "string",
          "format": "date",
          "description": "豁免到期日期"
        },
        "approvedBy": {
          "type": "string"
        }
      }
    },
    "A11yTestingConfig": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["axe-core", "pa11y", "lighthouse"],
          "default": "axe-core"
        },
        "runOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["build", "pr", "nightly"]
          }
        },
        "threshold": {
          "type": "object",
          "properties": {
            "critical": { "type": "number", "const": 0 },
            "serious": { "type": "number" },
            "moderate": { "type": "number" }
          }
        }
      }
    }
  }
}
