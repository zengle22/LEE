{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Acceptance Check Result Contract v1",
  "description": "ADR-025 验收自动检查结果",
  "type": "object",
  "required": ["status", "check_type", "dimensions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "escalate"]
    },
    "check_type": {
      "type": "string",
      "enum": ["auto", "review", "approval"]
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "schema_validation": { "type": "string", "enum": ["pass", "fail"] },
        "contract_validation": { "type": "string", "enum": ["pass", "fail"] },
        "completeness_check": { "type": "string", "enum": ["pass", "fail"] },
        "dependency_resolution": { "type": "string", "enum": ["pass", "fail"] }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
