{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-spec.example.com/contracts/source-freeze-contract/v1/schema.json",
  "title": "Source Freeze Contract",
  "description": "需求源冻结契约 - 正式 SRC 对象或其冻结视图。该契约表达单一 canonical SRC 冻结边界，不用于同一 run 内的多 SRC 扇出。",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "problem_statement",
    "target_user",
    "business_motivation",
    "constraints",
    "freeze_meta",
    "ssot"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "description": "SRC 对象唯一标识。单次 canonical raw_to_src run 只应对应一个 source_id。"
    },
    "title": {
      "type": "string",
      "description": "SRC 标题。必须与原始输入同题，不得将 intake、schema、workflow 方法论替代为标题主题。"
    },
    "problem_statement": {
      "type": "string",
      "description": "问题陈述。描述原始输入要解决的单一问题边界，而不是描述如何处理该输入的流程。"
    },
    "target_user": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "目标用户"
    },
    "trigger_context": {
      "type": "string",
      "description": "触发场景"
    },
    "business_motivation": {
      "type": "string",
      "description": "业务动因"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "关键约束"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freeze_meta": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "frozen", "superseded"]
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "frozen_by": {
          "type": "string"
        }
      }
    },
    "ssot": {
      "type": "object",
      "required": ["identity_kind", "ssot_type"],
      "properties": {
        "identity_kind": {
          "type": "string",
          "enum": ["ssot"]
        },
        "ssot_type": {
          "type": "string",
          "enum": ["SRC"]
        },
        "derived_from": {
          "type": "string"
        }
      },
      "description": "SSOT 身份信息。该对象表示一个 canonical SRC，而非同一输入拆分出的多个并列 SRC 集合。"
    }
  }
}
