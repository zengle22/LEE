{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-spec.example.com/contracts/product-feat-contract/v2/schema.json",
  "title": "Product FEAT Contract",
  "description": "产品 FEAT 契约 - 正式 FEAT 对象或其冻结视图，包含兼容 AC 列表和结构化 acceptance checks",
  "type": "object",
  "required": [
    "feat_id",
    "title",
    "goal",
    "user_value",
    "inputs",
    "input_contract",
    "processing",
    "outputs",
    "acceptance_criteria",
    "acceptance_checks",
    "dependencies",
    "non_goals",
    "priority",
    "delivery_slice",
    "lifecycle_status",
    "ssot"
  ],
  "properties": {
    "feat_id": { "type": "string" },
    "title": { "type": "string" },
    "goal": { "type": "string" },
    "user_value": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 3,
            "not": {
              "pattern": "(?i)^(inputs?\\s+defined\\s+by\\s+epic\\s+scope|same\\s+as\\s+epic|tbd|to\\s+be\\s+defined)$"
            }
          },
          {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "string", "minLength": 1 }
                }
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "input_contract": {
      "type": "object",
      "required": ["required_artifacts", "required_fields", "consumption_rules"],
      "properties": {
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "optional_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "consumption_rules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 6 }
        }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "user_stories": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["as_a", "i_want", "so_that"],
        "properties": {
          "as_a": { "type": "string" },
          "i_want": { "type": "string" },
          "so_that": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "scenario", "given", "when", "then", "trace_hints"],
        "properties": {
          "id": { "type": "string" },
          "scenario": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "trace_hints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["UI", "TECH", "TASK", "TESTSET"]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2"]
    },
    "delivery_slice": { "type": "string" },
    "lifecycle_status": {
      "type": "string",
      "enum": ["draft", "active", "frozen", "archived"]
    },
    "derived_object_expectations": {
      "type": "object",
      "properties": {
        "task_required": { "type": "boolean", "const": true },
        "testset_required": { "type": "boolean", "const": true },
        "testset_owner": { "type": "string", "enum": ["qa"] },
        "ui_optional": { "type": "boolean" },
        "tech_optional": { "type": "boolean" },
        "qa_seed_required": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "implementation_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Temporary compatibility field. Use TECH or TASK for implementation detail.",
      "default": []
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ssot": {
      "type": "object",
      "required": ["identity_kind", "ssot_type"],
      "properties": {
        "identity_kind": { "type": "string", "enum": ["ssot"] },
        "ssot_type": { "type": "string", "enum": ["FEAT"] },
        "parent": { "type": "string" },
        "derived_from": { "type": "string" }
      }
    },
    "testability_seed": {
      "type": "object",
      "properties": {
        "risk_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "integration_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority_hint": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "implementation_notes": {
          "maxItems": 0
        }
      }
    }
  ]
}
