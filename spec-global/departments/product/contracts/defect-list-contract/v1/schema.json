{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Defect List Contract v1",
  "description": "ADR-025 缺陷列表",
  "type": "object",
  "required": ["defects"],
  "properties": {
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "description", "status"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "dimension": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "suggestion": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "fixed", "deferred"] },
          "fix_version": { "type": ["string", "null"] }
        }
      }
    }
  }
}
