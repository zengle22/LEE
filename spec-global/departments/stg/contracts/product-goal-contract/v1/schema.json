{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-spec.example.com/contracts/product-goal-contract/v1/schema.json",
  "title": "Product Goal Contract Schema",
  "description": "Schema for product goal and value analysis contract - defines core objectives and business value",
  "type": "object",
  "required": ["contract_type", "contract_version", "contract_info", "requirement_overview", "key_designs"],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "product-goal-contract"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "contract_info": {
      "type": "object",
      "required": ["contract_id", "title", "version", "created_at", "status"],
      "properties": {
        "contract_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PENDING_CONFIRMATION", "CONFIRMED", "APPROVED", "REVISION_REQUIRED", "REJECTED"]
        }
      }
    },
    "requirement_overview": {
      "type": "object",
      "required": ["description", "target_users"],
      "properties": {
        "description": {
          "type": "string"
        },
        "target_users": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "expected_timeline": {
          "type": "string"
        }
      }
    },
    "key_designs": {
      "type": "object",
      "required": ["core_goal", "value_chain", "priority", "risks_and_boundaries"],
      "properties": {
        "core_goal": {
          "$ref": "#/$defs/CoreGoal"
        },
        "value_chain": {
          "$ref": "#/$defs/ValueChain"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "risks_and_boundaries": {
          "$ref": "#/$defs/RisksAndBoundaries"
        }
      }
    },
    "detailed_analysis": {
      "type": "object",
      "properties": {
        "user_value_analysis": { "type": "string" },
        "industry_analysis": { "type": "string" },
        "efficiency_analysis": { "type": "string" },
        "cost_analysis": { "type": "string" }
      }
    },
    "confirmation_summary": {
      "$ref": "#/$defs/ConfirmationSummary"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "changes": { "type": "string" },
          "author": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CoreGoal": {
      "type": "object",
      "required": ["primary_goal"],
      "properties": {
        "primary_goal": {
          "type": "object",
          "required": ["description", "rationale", "metrics", "success_criteria"],
          "properties": {
            "description": { "type": "string" },
            "rationale": { "type": "string" },
            "metrics": {
              "type": "array",
              "items": { "type": "string" }
            },
            "success_criteria": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "secondary_goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "priority": { "type": "integer" }
            }
          }
        },
        "confirmation": {
          "$ref": "#/$defs/ConfirmationPoint"
        }
      }
    },
    "ValueChain": {
      "type": "object",
      "required": ["user_need", "product_feature", "direct_value", "business_impact", "strategic_significance"],
      "properties": {
        "user_need": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "validation": { "type": "string" }
          }
        },
        "product_feature": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "validation": { "type": "string" }
          }
        },
        "direct_value": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "validation": { "type": "string" }
          }
        },
        "business_impact": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "validation": { "type": "string" }
          }
        },
        "strategic_significance": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "validation": { "type": "string" }
          }
        },
        "explanation": { "type": "string" },
        "confirmation": {
          "$ref": "#/$defs/ConfirmationPoint"
        }
      }
    },
    "Priority": {
      "type": "object",
      "required": ["scores", "recommendation"],
      "properties": {
        "scores": {
          "type": "object",
          "properties": {
            "user_value": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "rationale": { "type": "string" }
              }
            },
            "industry": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "rationale": { "type": "string" }
              }
            },
            "efficiency": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "rationale": { "type": "string" }
              }
            },
            "cost": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "rationale": { "type": "string" }
              }
            },
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "recommendation": {
          "type": "object",
          "properties": {
            "priority_level": {
              "type": "string",
              "enum": ["P0", "P1", "P2", "P3"]
            },
            "suggested_timeline": { "type": "string" },
            "resource_estimate": { "type": "string" },
            "rationale": { "type": "string" }
          }
        },
        "confirmation": {
          "$ref": "#/$defs/ConfirmationPoint"
        }
      }
    },
    "RisksAndBoundaries": {
      "type": "object",
      "properties": {
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "impact": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "mitigation": { "type": "string" }
            }
          }
        },
        "in_scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confirmation": {
          "$ref": "#/$defs/ConfirmationPoint"
        }
      }
    },
    "ConfirmationPoint": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "rejected", "revision_required"]
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answered": { "type": "boolean" }
            }
          }
        },
        "feedback": { "type": "string" },
        "confirmer": { "type": "string" },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ConfirmationSummary": {
      "type": "object",
      "properties": {
        "core_goal_status": { "type": "string" },
        "value_chain_status": { "type": "string" },
        "priority_status": { "type": "string" },
        "risks_status": { "type": "string" },
        "all_confirmed": { "type": "boolean" }
      }
    },
    "Approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "revision_required", "rejected"]
        },
        "decision": { "type": "string" },
        "approver": { "type": "string" },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "comments": { "type": "string" },
        "effective_status": { "type": "string" },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "next_stage": { "type": "string" },
        "owner": { "type": "string" }
      }
    }
  }
}
