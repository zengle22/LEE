{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-spec.example.com/contracts/frozen-analysis-contract/v1/schema.json",
  "title": "Frozen Analysis Contract Schema",
  "description": "Schema for frozen analysis output - the authoritative fact base for all downstream agents",
  "type": "object",
  "required": ["contract_type", "contract_version", "metadata", "quality_review", "frozen_facts"],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "frozen-analysis-output"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["analysis_id", "source_contracts", "frozen_at", "keyword", "quality_status", "is_frozen"],
      "properties": {
        "analysis_id": {
          "type": "string",
          "pattern": "^FA-\\d{8}-\\d{3}$"
        },
        "source_contracts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "frozen_version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+$"
        },
        "keyword": { "type": "string" },
        "quality_status": {
          "type": "string",
          "enum": ["passed", "needs_rework", "pending_review", "partially_passed"]
        },
        "review_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "is_frozen": {
          "type": "boolean"
        }
      }
    },
    "market_signal_freeze": {
      "$ref": "#/$defs/MarketSignalFreeze"
    },
    "quality_review": {
      "$ref": "#/$defs/QualityReview"
    },
    "frozen_facts": {
      "$ref": "#/$defs/FrozenFacts"
    },
    "integrated_insights": {
      "$ref": "#/$defs/IntegratedInsights"
    },
    "downstream_guidance": {
      "$ref": "#/$defs/DownstreamGuidance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "MarketSignalFreeze": {
      "type": "object",
      "properties": {
        "keyword_set": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "included": {
              "type": "array",
              "items": { "type": "string" }
            },
            "excluded": {
              "type": "array",
              "items": { "type": "string" }
            },
            "scope_definition": { "type": "string" }
          }
        },
        "accepted_assumptions": {
          "type": "object",
          "properties": {
            "user_problem": { "type": "string" },
            "industry_stage": {
              "type": "string",
              "enum": ["emerging", "growth", "mature", "declining"]
            },
            "supply_gap": { "type": "string" },
            "target_market": { "type": "string" },
            "additional": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "confidence_score": {
          "type": "object",
          "properties": {
            "data_confidence": {
              "type": "string",
              "pattern": "^[★]{1,5}$"
            },
            "assumption_risk": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "overall_reliability": { "type": "string" }
          }
        },
        "reopen_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition_id": {
                "type": "string",
                "pattern": "^RC-\\d{3}$"
              },
              "condition_type": {
                "type": "string",
                "enum": ["trend_reversal", "new_competitor", "market_shift", "regulation_change", "technology_disruption", "user_behavior_change", "data_invalidation", "assumption_violated"]
              },
              "description": { "type": "string" },
              "trigger_threshold": { "type": "string" },
              "monitoring_method": { "type": "string" },
              "priority": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              }
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "freeze_date": {
              "type": "string",
              "format": "date-time"
            },
            "review_date": {
              "type": "string",
              "format": "date-time"
            },
            "expiry_date": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "type": "string",
              "enum": ["active", "review_pending", "expired", "reopened", "superseded"]
            }
          }
        }
      }
    },
    "QualityReview": {
      "type": "object",
      "required": ["overall_status", "overall_score"],
      "properties": {
        "overall_status": {
          "type": "string",
          "enum": ["passed", "needs_rework", "pending_review", "partially_passed"]
        },
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dimension_reviews": {
          "type": "object",
          "properties": {
            "competitor_supply": { "$ref": "#/$defs/DimensionReview" },
            "industry_structure": { "$ref": "#/$defs/DimensionReview" },
            "user_signals": { "$ref": "#/$defs/DimensionReview" }
          }
        },
        "review_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round": { "type": "integer" },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "status": { "type": "string" },
              "feedback": { "type": "string" },
              "rework_items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "DimensionReview": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "needs_rework", "pending_review", "partially_passed"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["critical", "major", "minor", "info"]
              },
              "dimension": {
                "type": "string",
                "enum": ["completeness", "accuracy", "consistency", "timeliness", "traceability", "objectivity"]
              },
              "description": { "type": "string" },
              "expected": { "type": "string" },
              "actual": { "type": "string" },
              "remediation": { "type": "string" }
            }
          }
        },
        "rework_required": { "type": "boolean" },
        "rework_instructions": { "type": "string" }
      }
    },
    "FrozenFacts": {
      "type": "object",
      "properties": {
        "competitor_supply": {
          "type": "object",
          "properties": {
            "_frozen": { "type": "boolean", "const": true },
            "_frozen_at": {
              "type": "string",
              "format": "date-time"
            },
            "_version": { "type": "string" },
            "market_players": { "type": "object" },
            "top_products": {
              "type": "array",
              "items": { "type": "object" }
            },
            "supply_gaps": {
              "type": "array",
              "items": { "type": "object" }
            },
            "open_source_alternatives": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        },
        "industry_structure": {
          "type": "object",
          "properties": {
            "_frozen": { "type": "boolean", "const": true },
            "_frozen_at": {
              "type": "string",
              "format": "date-time"
            },
            "_version": { "type": "string" },
            "porter_five_forces": { "type": "object" },
            "market_fundamentals": { "type": "object" },
            "regulatory_environment": { "type": "object" }
          }
        },
        "user_signals": {
          "type": "object",
          "properties": {
            "_frozen": { "type": "boolean", "const": true },
            "_frozen_at": {
              "type": "string",
              "format": "date-time"
            },
            "_version": { "type": "string" },
            "user_demographics": { "type": "object" },
            "user_psychographics": { "type": "object" },
            "user_pain_points": {
              "type": "array",
              "items": { "type": "object" }
            },
            "user_behaviors": { "type": "object" },
            "demand_signals": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      }
    },
    "IntegratedInsights": {
      "type": "object",
      "properties": {
        "opportunity_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "opportunity_id": { "type": "string" },
              "description": { "type": "string" },
              "supporting_facts": { "type": "object" },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "priority": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              }
            }
          }
        },
        "risk_matrix": {
          "type": "array",
          "items": { "type": "object" }
        },
        "strategic_implications": {
          "type": "object",
          "properties": {
            "must_do": {
              "type": "array",
              "items": { "type": "string" }
            },
            "must_avoid": {
              "type": "array",
              "items": { "type": "string" }
            },
            "key_success_factors": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "one_line_summary": { "type": "string" }
      }
    },
    "DownstreamGuidance": {
      "type": "object",
      "properties": {
        "frozen_facts_usage": {
          "type": "object",
          "properties": {
            "must_respect": {
              "type": "array",
              "items": { "type": "object" }
            },
            "can_interpret": {
              "type": "array",
              "items": { "type": "object" }
            },
            "cannot_change": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        },
        "for_prd_designer": { "type": "object" },
        "for_plan_architect": { "type": "object" },
        "validation_checkpoints": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
