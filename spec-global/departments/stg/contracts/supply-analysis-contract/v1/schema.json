{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-spec.example.com/contracts/supply-analysis-contract/v1/schema.json",
  "title": "Supply Analysis Contract Schema",
  "description": "Schema for competitor supply analysis output - existing solutions and market gaps",
  "type": "object",
  "required": ["contract_type", "contract_version", "metadata", "existing_solutions", "gaps"],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "supply-analysis-output"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["analysis_id", "source_contract", "generated_at", "keyword"],
      "properties": {
        "analysis_id": {
          "type": "string",
          "pattern": "^SA-\\d{8}-\\d{3}$"
        },
        "source_contract": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "keyword": {
          "type": "string"
        }
      }
    },
    "existing_solutions": {
      "$ref": "#/$defs/ExistingSolutions"
    },
    "gaps": {
      "$ref": "#/$defs/Gaps"
    },
    "pending_confirmation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingConfirmation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ExistingSolutions": {
      "type": "object",
      "required": ["summary", "total_count", "categories"],
      "properties": {
        "summary": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SolutionCategory"
          },
          "minItems": 2
        }
      }
    },
    "SolutionCategory": {
      "type": "object",
      "required": ["category_name", "solutions"],
      "properties": {
        "category_name": {
          "type": "string"
        },
        "solutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Solution"
          }
        }
      }
    },
    "Solution": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pricing": {
          "type": "string"
        },
        "strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "weaknesses": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Gaps": {
      "type": "object",
      "properties": {
        "unserved_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segment", "evidence"],
            "properties": {
              "segment": { "type": "string" },
              "evidence": { "type": "string" },
              "opportunity": { "type": "string" }
            }
          }
        },
        "poor_ux": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue"],
            "properties": {
              "issue": { "type": "string" },
              "affected_solutions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "user_complaints": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "high_cost": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue"],
            "properties": {
              "issue": { "type": "string" },
              "current_pricing": { "type": "string" },
              "underserved_users": { "type": "string" }
            }
          }
        },
        "poor_integration": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue"],
            "properties": {
              "issue": { "type": "string" },
              "missing_integrations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "user_impact": { "type": "string" }
            }
          }
        },
        "other_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue"],
            "properties": {
              "issue": { "type": "string" },
              "details": { "type": "string" }
            }
          }
        }
      }
    },
    "PendingConfirmation": {
      "type": "object",
      "required": ["id", "question", "priority"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PC-\\d{3}$"
        },
        "question": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "important", "nice_to_have"]
        }
      }
    }
  }
}
