{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lee.dev/spec-global/core/contracts/reverse-evidence-index/v1/schema.json",
  "title": "Reverse Evidence Index",
  "type": "object",
  "required": ["repo_root", "evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "repo_root": { "type": "string" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "paths"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "routes": { "type": "array", "items": { "type": "string" } },
    "apis": { "type": "array", "items": { "type": "string" } },
    "ui_entrypoints": { "type": "array", "items": { "type": "string" } },
    "service_files": { "type": "array", "items": { "type": "string" } },
    "test_files": { "type": "array", "items": { "type": "string" } },
    "existing_docs": { "type": "array", "items": { "type": "string" } },
    "runtime_artifacts": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "path", "kind"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string" },
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["code", "test", "doc", "runtime", "config"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
