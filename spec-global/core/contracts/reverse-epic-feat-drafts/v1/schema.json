{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lee.dev/spec-global/core/contracts/reverse-epic-feat-drafts/v1/schema.json",
  "title": "Reverse EPIC FEAT Drafts",
  "type": "object",
  "required": ["epics", "feats"],
  "additionalProperties": false,
  "properties": {
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary", "evidence_refs", "primary_refs", "evidence_layers", "evidence_strategy"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "capability_refs": { "type": "array", "items": { "type": "string" } },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "primary_refs": { "type": "array", "items": { "type": "string" } },
          "evidence_layers": {
            "type": "object",
            "required": ["impl_refs", "api_refs", "test_refs", "doc_refs"],
            "additionalProperties": false,
            "properties": {
              "impl_refs": { "type": "array", "items": { "type": "string" } },
              "api_refs": { "type": "array", "items": { "type": "string" } },
              "test_refs": { "type": "array", "items": { "type": "string" } },
              "doc_refs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "evidence_strategy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "primary_selection": { "type": "string", "enum": ["ordered_impl_api_first"] },
              "ranking_signals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["path_quality", "semantic_path_match", "page_content_match", "onboarding_local_rerank"]
                }
              }
            }
          }
        }
      }
    },
    "feats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary", "scope", "inputs", "outputs", "business_rules", "acceptance_criteria", "code_refs", "evidence_refs", "primary_refs", "evidence_layers"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "epic_ref": { "type": "string" },
          "capability_ref": { "type": "string" },
          "scope": {
            "type": "object",
            "required": ["in_scope", "out_of_scope"],
            "additionalProperties": false,
            "properties": {
              "in_scope": { "type": "array", "items": { "type": "string" } },
              "out_of_scope": { "type": "array", "items": { "type": "string" } }
            }
          },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "business_rules": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "code_refs": { "type": "array", "items": { "type": "string" } },
          "primary_refs": { "type": "array", "items": { "type": "string" } },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "evidence_layers": {
            "type": "object",
            "required": ["impl_refs", "api_refs", "test_refs", "doc_refs"],
            "additionalProperties": false,
            "properties": {
              "impl_refs": { "type": "array", "items": { "type": "string" } },
              "api_refs": { "type": "array", "items": { "type": "string" } },
              "test_refs": { "type": "array", "items": { "type": "string" } },
              "doc_refs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "evidence_strategy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "primary_selection": { "type": "string", "enum": ["ordered_impl_api_first"] },
              "ranking_signals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["path_quality", "semantic_path_match", "page_content_match", "onboarding_local_rerank"]
                }
              }
            }
          },
          "inference": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
