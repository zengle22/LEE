{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/spec-review-contract/v1/output.schema.json",
    "title": "Spec Review Output Schema",
    "description": "Output schema for the Spec Review Agent",
    "type": "object",
    "required": [
        "summary",
        "findings"
    ],
    "properties": {
        "summary": {
            "type": "object",
            "description": "Summary counts by severity",
            "required": [
                "blockers",
                "majors",
                "minors",
                "nits"
            ],
            "properties": {
                "blockers": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Count of blocker-level findings"
                },
                "majors": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Count of major-level findings"
                },
                "minors": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Count of minor-level findings"
                },
                "nits": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Count of nit-level findings"
                }
            }
        },
        "findings": {
            "type": "array",
            "description": "List of all findings",
            "items": {
                "type": "object",
                "required": [
                    "severity",
                    "code",
                    "message",
                    "location",
                    "fix"
                ],
                "properties": {
                    "severity": {
                        "type": "string",
                        "enum": [
                            "blocker",
                            "major",
                            "minor",
                            "nit"
                        ],
                        "description": "Severity level of the finding"
                    },
                    "code": {
                        "type": "string",
                        "pattern": "^[A-Z_]+$",
                        "description": "Unique code for this type of finding (e.g., AGENT_MISSING_CONTRACTS)"
                    },
                    "message": {
                        "type": "string",
                        "description": "Human-readable description of the issue"
                    },
                    "location": {
                        "type": "object",
                        "required": [
                            "path"
                        ],
                        "properties": {
                            "path": {
                                "type": "string",
                                "description": "JSONPath or YAML path to the problematic element (e.g., $.contracts)"
                            },
                            "line": {
                                "type": "integer",
                                "minimum": 1,
                                "description": "Line number in the source file (optional)"
                            }
                        }
                    },
                    "fix": {
                        "type": "object",
                        "required": [
                            "suggestion"
                        ],
                        "properties": {
                            "suggestion": {
                                "type": "string",
                                "description": "Human-readable fix suggestion"
                            },
                            "patch": {
                                "type": "string",
                                "description": "Optional YAML/JSON patch that can be directly applied"
                            }
                        }
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "properties": {
                "reviewed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp of the review"
                },
                "spec_kind": {
                    "type": "string",
                    "enum": [
                        "skill",
                        "agent",
                        "workflow",
                        "contract",
                        "unknown"
                    ],
                    "description": "Detected kind of the spec"
                },
                "spec_version": {
                    "type": "string",
                    "description": "Detected version of the spec"
                }
            }
        }
    }
}