{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lee.dev/spec-global/core/contracts/reverse-capability-map/v1/schema.json",
  "title": "Reverse Capability Map",
  "type": "object",
  "required": ["capabilities"],
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "boundary", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-[0-9]{3}$" },
          "name": { "type": "string" },
          "boundary": { "type": "string" },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
