{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lee.local/contracts/tech-contract/v1/schema.json",
  "title": "TECH Bridge Contract",
  "description": "TECH 桥接对象契约 - 负责将 FEAT 形式化翻译为交付与实现约束。",
  "type": "object",
  "required": [
    "id",
    "ssot_type",
    "title",
    "parent_id",
    "derived_from_ids",
    "source_refs",
    "architecture_decisions",
    "feat_mapping",
    "implementation_rules",
    "delivery_handoffs",
    "validation_rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TECH-[A-Z0-9-]+$"
    },
    "ssot_type": {
      "type": "string",
      "const": "tech"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "parent_id": {
      "type": "string",
      "pattern": "^FEAT-[A-Z0-9-]+$"
    },
    "derived_from_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(EPIC|FEAT|TASK|ADR)-[A-Z0-9-]+$"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "architecture_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decision", "reason", "impact"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "decision": { "type": "string", "minLength": 6 },
          "reason": { "type": "string", "minLength": 6 },
          "impact": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          }
        },
        "additionalProperties": false
      }
    },
    "feat_mapping": {
      "type": "object",
      "required": ["feat_id", "goal_mapping", "acceptance_mapping"],
      "properties": {
        "feat_id": {
          "type": "string",
          "pattern": "^FEAT-[A-Z0-9-]+$"
        },
        "goal_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["feat_clause", "tech_response"],
            "properties": {
              "feat_clause": { "type": "string", "minLength": 3 },
              "tech_response": { "type": "string", "minLength": 3 }
            },
            "additionalProperties": false
          }
        },
        "acceptance_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["acceptance_id", "implementation_unit"],
            "properties": {
              "acceptance_id": { "type": "string", "minLength": 2 },
              "implementation_unit": { "type": "string", "minLength": 2 },
              "evidence_ref": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "implementation_rules": {
      "type": "object",
      "required": ["required_inputs", "required_outputs", "forbidden_shortcuts"],
      "properties": {
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "forbidden_shortcuts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        }
      },
      "additionalProperties": false
    },
    "delivery_handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "artifacts"],
        "properties": {
          "from": { "type": "string", "minLength": 2 },
          "to": { "type": "string", "minLength": 2 },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          }
        },
        "additionalProperties": false
      }
    },
    "validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule", "description"],
        "properties": {
          "rule": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 6 },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
