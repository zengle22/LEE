{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/requirement-review/v1/schema.json",
    "title": "Requirement Review Contract",
    "description": "需求评审契约 - 验证需求单元与价值冻结的对齐度，总结讨论点",
    "type": "object",
    "required": [
        "contract_type",
        "contract_version",
        "metadata",
        "review_summary",
        "discussion_points"
    ],
    "properties": {
        "contract_type": {
            "type": "string",
            "const": "requirement-review"
        },
        "contract_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
        },
        "metadata": {
            "type": "object",
            "required": [
                "generated_at",
                "source_documents"
            ],
            "properties": {
                "contract_id": {
                    "type": "string",
                    "pattern": "^RR-\\d{8}-\\d{3}$"
                },
                "source_documents": {
                    "type": "object",
                    "properties": {
                        "value_freeze": {
                            "type": "string"
                        },
                        "requirement_breakdown": {
                            "type": "string"
                        }
                    }
                },
                "generated_at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "review_summary": {
            "type": "object",
            "properties": {
                "total_units": {
                    "type": "integer"
                },
                "aligned": {
                    "type": "integer"
                },
                "needs_discussion": {
                    "type": "integer"
                },
                "out_of_scope": {
                    "type": "integer"
                }
            }
        },
        "unit_reviews": {
            "type": "array",
            "description": "每个需求单元的评审结果",
            "items": {
                "type": "object",
                "required": [
                    "unit_id",
                    "alignment_status"
                ],
                "properties": {
                    "unit_id": {
                        "type": "string"
                    },
                    "alignment_status": {
                        "type": "string",
                        "enum": [
                            "aligned",
                            "needs_discussion",
                            "out_of_scope",
                            "deferred"
                        ]
                    },
                    "value_link": {
                        "type": "string",
                        "description": "关联到的价值目标"
                    },
                    "concerns": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "recommendation": {
                        "type": "string"
                    }
                }
            }
        },
        "discussion_points": {
            "type": "array",
            "description": "需要人类确认的讨论点",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "topic",
                    "question"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^DP-\\d{3}$"
                    },
                    "topic": {
                        "type": "string"
                    },
                    "question": {
                        "type": "string"
                    },
                    "related_units": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "options": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "impact": {
                        "type": "string"
                    },
                    "decision": {
                        "type": "object",
                        "properties": {
                            "chosen_option": {
                                "type": "string"
                            },
                            "decided_by": {
                                "type": "string"
                            },
                            "decided_at": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "rationale": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "scope_changes": {
            "type": "object",
            "properties": {
                "added": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "removed": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "modified": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "freeze_readiness": {
            "type": "object",
            "properties": {
                "is_ready": {
                    "type": "boolean"
                },
                "blocking_issues": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "approval_status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "approved",
                        "rejected"
                    ]
                }
            }
        }
    }
}