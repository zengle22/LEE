{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/qa-input/v1",
  "title": "QA Input",
  "description": "QA 工程师的输入契约：需求文档或需求变更",
  "type": "object",
  "required": ["input_type", "module"],
  "properties": {
    "input_type": {
      "type": "string",
      "enum": ["new_feature", "requirement_change", "bug_fix", "regression_request"],
      "description": "输入类型"
    },
    "module": {
      "type": "string",
      "description": "模块名称"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "description": "需求列表"
    },
    "prd_reference": {
      "type": "object",
      "properties": {
        "prd_id": {
          "type": "string",
          "description": "PRD ID"
        },
        "version": {
          "type": "string",
          "description": "PRD 版本"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "PRD 链接"
        }
      },
      "description": "PRD 引用"
    },
    "api_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "contract_path": {
            "type": "string"
          }
        }
      },
      "description": "相关 API 契约"
    },
    "ui_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string"
          },
          "contract_path": {
            "type": "string"
          }
        }
      },
      "description": "相关 UI 契约"
    },
    "bug_info": {
      "type": "object",
      "properties": {
        "bug_id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "description": {
          "type": "string"
        },
        "root_cause": {
          "type": "string"
        },
        "fix_description": {
          "type": "string"
        }
      },
      "description": "Bug 信息（用于回归测试）"
    },
    "existing_test_cases": {
      "type": "object",
      "properties": {
        "contract_path": {
          "type": "string",
          "description": "现有测试用例契约路径"
        },
        "affected_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "受影响的用例ID列表"
        }
      },
      "description": "现有测试用例（需求变更时）"
    },
    "acceptance_context": {
      "type": "object",
      "properties": {
        "user_personas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "目标用户角色"
        },
        "critical_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "关键用户路径"
        },
        "non_functional_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["performance", "security", "accessibility", "compatibility"]
              },
              "requirement": {
                "type": "string"
              }
            }
          },
          "description": "非功能性需求"
        }
      },
      "description": "验收上下文"
    }
  },
  "$defs": {
    "Requirement": {
      "type": "object",
      "required": ["id", "description", "acceptance_criteria"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Z]+-\\d+$",
          "description": "需求ID"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "需求描述"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2"],
          "description": "优先级"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "验收标准"
        },
        "user_story": {
          "type": "string",
          "description": "用户故事"
        },
        "edge_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "边界场景"
        },
        "error_scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "异常场景"
        }
      }
    }
  }
}
