{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/delivery-gate-output/v1",
  "title": "Delivery Gate Output",
  "description": "交付门禁 Agent 的输出契约",
  "type": "object",
  "required": ["gate_id", "gate_type", "timestamp", "verdict", "checks"],
  "properties": {
    "gate_id": {
      "type": "string",
      "description": "门禁记录ID"
    },
    "gate_type": {
      "type": "string",
      "enum": ["merge_gate", "release_gate", "hotfix_gate"],
      "description": "门禁类型"
    },
    "project": {
      "type": "string",
      "description": "项目名称"
    },
    "branch": {
      "type": "string",
      "description": "分支名称"
    },
    "requester": {
      "type": "string",
      "description": "请求人"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "判定时间"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "WARN"],
      "description": "总体判定"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rule", "current_value", "result", "blocker"],
        "properties": {
          "name": {
            "type": "string",
            "description": "检查项名称"
          },
          "rule": {
            "type": "string",
            "description": "检查规则"
          },
          "current_value": {
            "type": "string",
            "description": "当前值"
          },
          "required_value": {
            "type": "string",
            "description": "要求值"
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "warn", "skipped"],
            "description": "检查结果"
          },
          "blocker": {
            "type": "boolean",
            "description": "是否为阻塞项"
          }
        }
      },
      "description": "检查详情"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_name", "issue", "action", "owner"],
        "properties": {
          "check_name": {
            "type": "string",
            "description": "检查项名称"
          },
          "issue": {
            "type": "string",
            "description": "问题描述"
          },
          "current_value": {
            "type": "string",
            "description": "当前值"
          },
          "required_value": {
            "type": "string",
            "description": "要求值"
          },
          "action": {
            "type": "string",
            "description": "修复动作"
          },
          "owner": {
            "type": "string",
            "description": "负责人/角色"
          }
        }
      },
      "description": "阻塞项列表（必须修复）"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_name", "issue"],
        "properties": {
          "check_name": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "警告项列表（应当修复）"
    },
    "exemptions_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          }
        }
      },
      "description": "已应用的豁免"
    },
    "evidence_links": {
      "type": "object",
      "properties": {
        "coverage_report": {
          "type": "string",
          "format": "uri"
        },
        "e2e_report": {
          "type": "string",
          "format": "uri"
        },
        "security_scan": {
          "type": "string",
          "format": "uri"
        },
        "code_review": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "证据链接"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_checks": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        }
      },
      "description": "检查统计摘要"
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "下一步行动建议"
    }
  }
}
