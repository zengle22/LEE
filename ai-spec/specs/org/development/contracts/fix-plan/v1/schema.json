{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/development/fix-plan/v1",
  "title": "Bug Fix Plan Schema",
  "description": "Bug 修复计划契约 - 返修阶段的修复方案",
  "type": "object",
  "required": [
    "plan_id",
    "retest_round",
    "bugs_to_fix",
    "scope_constraints",
    "regression_plan",
    "created_at"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^FIXPLAN-[0-9]{4}-[0-9]{4}$",
      "description": "修复计划 ID"
    },
    "retest_round": {
      "type": "integer",
      "minimum": 1
    },
    "bugs_to_fix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bug_id", "severity", "owner", "approach"],
        "properties": {
          "bug_id": {
            "type": "string",
            "pattern": "^BUG-[0-9]{4}-[0-9]{4}$"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "owner": {
            "type": "string",
            "description": "负责修复的 agent 或 developer"
          },
          "approach": {
            "type": "string",
            "description": "修复方案简述"
          },
          "estimated_effort_hours": {
            "type": "number",
            "minimum": 0
          },
          "affected_modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "scope_constraints": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "允许的修改范围"
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "禁止的行为"
        },
        "modules_in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules_out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "regression_plan": {
      "type": "object",
      "required": ["regression_tests_needed", "test_coverage_target"],
      "properties": {
        "regression_tests_needed": {
          "type": "integer",
          "minimum": 1,
          "description": "需要补充的回归测试数量"
        },
        "test_coverage_target": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "目标覆盖率"
        },
        "tests_to_add": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_name": { "type": "string" },
              "bug_id": { "type": "string" },
              "test_type": {
                "type": "string",
                "enum": ["unit", "integration", "e2e"]
              },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "overall_risk": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "risk": { "type": "string" },
              "level": { "type": "string" },
              "mitigation": { "type": "string" }
            }
          }
        }
      }
    },
    "estimated_completion": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  }
}
