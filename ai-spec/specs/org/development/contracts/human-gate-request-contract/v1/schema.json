{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-gate-request-contract/v1/schema.json",
  "title": "Human Gate Request Contract",
  "description": "人类门禁请求格式契约 - 定义审批/审查请求的结构",
  "type": "object",
  "required": ["request_id", "gate_id", "type", "workflow_context", "created_at", "timeout"],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^HGR-[0-9]{8}-[A-Z0-9]{6}$",
      "description": "请求唯一标识"
    },
    "gate_id": {
      "type": "string",
      "description": "门禁 ID (对应 workflow 中的 human_in_the_loop.id)"
    },
    "type": {
      "type": "string",
      "enum": ["approval", "review", "notification"],
      "description": "门禁类型"
    },
    "workflow_context": {
      "type": "object",
      "description": "工作流上下文",
      "required": ["workflow_id", "step_id"],
      "properties": {
        "workflow_id": {
          "type": "string",
          "description": "工作流 ID"
        },
        "workflow_name": {
          "type": "string",
          "description": "工作流名称"
        },
        "phase_id": {
          "type": "string",
          "description": "Phase ID"
        },
        "step_id": {
          "type": "string",
          "description": "步骤 ID"
        },
        "step_name": {
          "type": "string",
          "description": "步骤名称"
        },
        "agent_id": {
          "type": "string",
          "description": "执行该步骤的 Agent ID"
        }
      }
    },
    "purpose": {
      "type": "string",
      "description": "门禁目的描述"
    },
    "blocking": {
      "type": "boolean",
      "default": true,
      "description": "是否阻断执行"
    },
    "artifacts_to_review": {
      "type": "array",
      "description": "需要审查的产物列表",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "description": "产物路径"
          },
          "description": {
            "type": "string",
            "description": "产物描述"
          },
          "preview_url": {
            "type": "string",
            "format": "uri",
            "description": "预览链接"
          },
          "content_type": {
            "type": "string",
            "description": "内容类型"
          }
        }
      }
    },
    "review_checklist": {
      "type": "array",
      "description": "审查清单",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "available_actions": {
      "type": "array",
      "description": "可用的操作选项",
      "items": {
        "type": "object",
        "required": ["action", "label"],
        "properties": {
          "action": {
            "type": "string",
            "description": "操作标识"
          },
          "label": {
            "type": "string",
            "description": "操作显示名称"
          },
          "next_step": {
            "type": "string",
            "enum": ["continue", "retry_step", "fail", "rollback_to_phase", "continue_with_issues", "continue_with_conditions"],
            "description": "下一步行为"
          },
          "requires_comment": {
            "type": "boolean",
            "default": false,
            "description": "是否需要备注"
          },
          "style": {
            "type": "string",
            "enum": ["primary", "secondary", "danger"],
            "description": "按钮样式"
          }
        }
      }
    },
    "approval_config": {
      "type": "object",
      "description": "审批配置",
      "properties": {
        "required_roles": {
          "type": "array",
          "description": "需要的角色",
          "items": {
            "type": "string"
          }
        },
        "min_approvals": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "最少审批人数"
        },
        "current_approvals": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "当前已审批人数"
        },
        "approvers": {
          "type": "array",
          "description": "已审批人列表",
          "items": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "timeout": {
      "type": "object",
      "description": "超时配置",
      "required": ["duration", "action"],
      "properties": {
        "duration": {
          "type": "string",
          "pattern": "^[0-9]+[hmd]$",
          "description": "超时时长 (如 24h, 7d)"
        },
        "action": {
          "type": "string",
          "enum": ["skip", "fail", "escalate"],
          "description": "超时后行为"
        },
        "escalation_target": {
          "type": "string",
          "description": "升级目标 (当 action 为 escalate 时)"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "过期时间"
        }
      }
    },
    "notification": {
      "type": "object",
      "description": "通知配置",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["console", "email", "slack", "webhook"]
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template": {
          "type": "string",
          "description": "通知模板名称"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "请求创建时间"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_review", "approved", "rejected", "timeout", "escalated"],
      "default": "pending",
      "description": "请求状态"
    },
    "metadata": {
      "type": "object",
      "description": "扩展元数据",
      "additionalProperties": true
    }
  }
}
