{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/development/retest-manifest/v1",
  "title": "Retest Release Manifest Schema",
  "description": "返修提测包清单契约 - 测试打回后的简化提测包",
  "type": "object",
  "required": [
    "manifest_id",
    "manifest_type",
    "version",
    "original_manifest_id",
    "retest_round",
    "bugs_fixed",
    "fix_commits",
    "selfcheck_summary",
    "risk_areas",
    "submitted_at",
    "submitted_by"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^RETEST-MAN-[0-9]{4}-[0-9]{4}$",
      "description": "返修提测包 ID（例如：RETEST-MAN-2026-0001）"
    },
    "manifest_type": {
      "type": "string",
      "const": "retest",
      "description": "必须为 retest 类型"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc[0-9]+$",
      "description": "版本号（必须递增 rc，如 v1.1.0-rc2）"
    },
    "original_manifest_id": {
      "type": "string",
      "description": "原始提测包 ID"
    },
    "retest_round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "返修轮次（1-3）"
    },
    "bugs_fixed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bug_id", "severity", "status"],
        "properties": {
          "bug_id": {
            "type": "string",
            "pattern": "^BUG-[0-9]{4}-[0-9]{4}$"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "status": {
            "type": "string",
            "enum": ["FIXED", "PARTIALLY_FIXED", "WONT_FIX"]
          },
          "fix_description": {
            "type": "string"
          },
          "regression_test_added": {
            "type": "boolean"
          }
        }
      },
      "description": "已修复的 Bug 列表"
    },
    "fix_commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["commit_hash", "message", "files_changed"],
        "properties": {
          "commit_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{7,40}$"
          },
          "message": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "files_changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_bugs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^BUG-[0-9]{4}-[0-9]{4}$"
            }
          }
        }
      },
      "description": "修复提交列表"
    },
    "selfcheck_summary": {
      "type": "object",
      "required": ["unit_test", "local_smoke", "overall_status"],
      "properties": {
        "unit_test": {
          "type": "object",
          "required": ["passed", "total", "pass_rate"],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "pass_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "report_url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "local_smoke": {
          "type": "object",
          "required": ["passed", "total"],
          "properties": {
            "passed": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "regression_tests": {
          "type": "object",
          "properties": {
            "added": {
              "type": "integer"
            },
            "passed": {
              "type": "integer"
            },
            "coverage": {
              "type": "number"
            }
          }
        },
        "overall_status": {
          "type": "string",
          "enum": ["PASSED", "PASSED_WITH_WARNINGS", "FAILED"]
        }
      },
      "description": "开发自检结果摘要"
    },
    "risk_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "change_type", "risk_level"],
        "properties": {
          "area": {
            "type": "string",
            "description": "受影响的代码区域或模块"
          },
          "change_type": {
            "type": "string",
            "enum": ["bug_fix", "config_change", "test_addition", "refactor"]
          },
          "risk_level": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "files_affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regression_risk": {
            "type": "string"
          }
        }
      },
      "description": "风险区域声明"
    },
    "scope_declaration": {
      "type": "object",
      "properties": {
        "new_features_added": {
          "type": "boolean",
          "const": false,
          "description": "必须为 false - 不允许新增功能"
        },
        "requirement_changes": {
          "type": "boolean",
          "const": false,
          "description": "必须为 false - 不允许需求变更"
        },
        "only_bug_fixes": {
          "type": "boolean",
          "const": true,
          "description": "必须为 true - 仅修复 Bug"
        },
        "modules_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "范围声明（防止夹带需求）"
    },
    "test_strategy": {
      "type": "object",
      "properties": {
        "recommended_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["smoke_test", "regression_test", "affected_module_test", "full_test"]
          }
        },
        "skip_full_test_rationale": {
          "type": "string"
        }
      },
      "description": "建议的测试策略"
    },
    "rollback_plan": {
      "type": "string",
      "description": "回滚方案"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "提交时间"
    },
    "submitted_by": {
      "type": "string",
      "description": "提交人/Agent"
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "accepted", "rejected"],
      "default": "pending"
    }
  }
}
