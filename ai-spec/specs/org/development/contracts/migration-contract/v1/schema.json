{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/migration-contract/v1",
  "title": "Migration Contract",
  "description": "Database Engineer 输出的数据库迁移契约",
  "type": "object",
  "required": ["version", "description", "status", "compatibility", "affected_tables", "up_script", "down_script", "estimated_duration"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^V\\d{8}_\\d+$",
      "description": "迁移版本号，格式: V{YYYYMMDD}_{sequence}"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "变更描述"
    },
    "author": {
      "type": "string",
      "description": "作者"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "创建日期"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved", "staging_executed", "production_executed", "rolled_back"],
      "description": "迁移状态"
    },
    "compatibility": {
      "type": "object",
      "required": ["forward", "backward"],
      "properties": {
        "forward": {
          "type": "object",
          "required": ["compatible", "description"],
          "properties": {
            "compatible": {
              "type": "boolean",
              "description": "新代码是否兼容旧 Schema"
            },
            "description": {
              "type": "string",
              "description": "向前兼容性说明"
            }
          }
        },
        "backward": {
          "type": "object",
          "required": ["compatible", "description"],
          "properties": {
            "compatible": {
              "type": "boolean",
              "description": "旧代码是否兼容新 Schema"
            },
            "description": {
              "type": "string",
              "description": "向后兼容性说明"
            }
          }
        }
      },
      "description": "兼容性说明"
    },
    "affected_tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["table_name", "operation", "blocking"],
        "properties": {
          "table_name": {
            "type": "string",
            "description": "表名"
          },
          "operation": {
            "type": "string",
            "enum": ["CREATE", "ALTER", "DROP", "RENAME", "ADD_COLUMN", "DROP_COLUMN", "ADD_INDEX", "DROP_INDEX"],
            "description": "操作类型"
          },
          "blocking": {
            "type": "boolean",
            "description": "是否阻塞表（锁表操作）"
          },
          "estimated_rows": {
            "type": "integer",
            "description": "预估影响行数"
          }
        }
      },
      "description": "影响的表"
    },
    "estimated_duration": {
      "type": "object",
      "required": ["staging", "production"],
      "properties": {
        "staging": {
          "type": "string",
          "description": "Staging 环境预估耗时"
        },
        "production": {
          "type": "string",
          "description": "Production 环境预估耗时"
        }
      },
      "description": "执行耗时预估"
    },
    "up_script": {
      "type": "string",
      "minLength": 10,
      "description": "正向迁移 SQL 脚本"
    },
    "down_script": {
      "type": "string",
      "minLength": 10,
      "description": "回滚 SQL 脚本"
    },
    "data_repair_script": {
      "type": "string",
      "description": "数据修复脚本（如需）"
    },
    "verification_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "验证步骤"
    },
    "rollback_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "action"],
        "properties": {
          "condition": {
            "type": "string",
            "description": "触发条件"
          },
          "action": {
            "type": "string",
            "description": "触发动作"
          }
        }
      },
      "description": "回滚触发条件"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "likelihood", "impact", "mitigation"],
        "properties": {
          "description": {
            "type": "string"
          },
          "likelihood": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "impact": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "mitigation": {
            "type": "string"
          }
        }
      },
      "description": "风险评估"
    },
    "execution_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["environment", "timestamp", "result"],
        "properties": {
          "environment": {
            "type": "string",
            "enum": ["staging", "production"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string",
            "enum": ["success", "failed", "rolled_back"]
          },
          "duration": {
            "type": "string"
          },
          "executed_by": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "执行日志"
    }
  }
}
