{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract.test.e2e_report.v1",
  "title": "E2E Test Report Contract",
  "description": "E2E 测试报告契约，用于门禁判定和人类可读展示",
  "type": "object",
  "required": ["report_id", "run_id", "manifest_id", "summary", "verdict"],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^E2E-RPT-[0-9]{8}-[A-Z0-9]+$",
      "description": "报告 ID"
    },
    "run_id": {
      "type": "string",
      "description": "关联的执行 ID"
    },
    "manifest_id": {
      "type": "string",
      "description": "关联的提测包 ID"
    },
    "version": {
      "type": "string",
      "description": "被测版本"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "报告生成时间"
    },
    "generator": {
      "type": "string",
      "description": "生成者 Agent ID"
    },
    "platform": {
      "type": "string",
      "enum": ["chrome", "wechat-miniprogram", "h5"],
      "description": "测试平台"
    },
    "environment": {
      "type": "object",
      "properties": {
        "base_url": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" }
      }
    },
    "execution_window": {
      "type": "object",
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "pass_rate"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "error": { "type": "integer" },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "通过率百分比"
        },
        "p0_pass_rate": {
          "type": "number",
          "description": "P0 用例通过率"
        },
        "p1_pass_rate": {
          "type": "number",
          "description": "P1 用例通过率"
        }
      }
    },
    "by_module": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": { "type": "string" },
          "total": { "type": "integer" },
          "passed": { "type": "integer" },
          "failed": { "type": "integer" },
          "pass_rate": { "type": "number" }
        }
      },
      "description": "按模块统计"
    },
    "failed_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": { "type": "string" },
          "name": { "type": "string" },
          "priority": { "type": "string" },
          "module": { "type": "string" },
          "failure_category": { "type": "string" },
          "failure_message": { "type": "string" },
          "failed_step": { "type": "integer" },
          "screenshot": { "type": "string" },
          "video": { "type": "string" },
          "bug_id": { "type": "string" }
        }
      },
      "description": "失败用例列表"
    },
    "flaky_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": { "type": "string" },
          "name": { "type": "string" },
          "retry_count": { "type": "integer" },
          "final_status": { "type": "string" }
        }
      },
      "description": "不稳定用例 (重试后通过)"
    },
    "bugs_auto_created": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bug_id": { "type": "string" },
          "case_id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string" }
        }
      },
      "description": "自动创建的 Bug"
    },
    "gate_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": { "type": "string" },
          "name": { "type": "string" },
          "required": { "type": "number" },
          "actual": { "type": "number" },
          "result": {
            "type": "string",
            "enum": ["pass", "fail"]
          }
        }
      },
      "description": "门禁检查项"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "CONDITIONAL_PASS"],
      "description": "门禁判定结果"
    },
    "verdict_reason": {
      "type": "string",
      "description": "判定原因"
    },
    "recommendation": {
      "type": "string",
      "enum": ["proceed", "fix_and_retest", "block"],
      "description": "建议动作"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "html_report": { "type": "string" },
        "json_report": { "type": "string" },
        "screenshots_archive": { "type": "string" },
        "videos_archive": { "type": "string" },
        "traces_archive": { "type": "string" }
      },
      "description": "产物路径"
    },
    "notes": {
      "type": "string",
      "description": "备注"
    }
  }
}
