{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/testing/smoke-test-result/v1",
  "title": "Smoke Test Result Contract",
  "description": "冒烟测试结果契约 - 记录冒烟测试执行结果",
  "type": "object",
  "required": [
    "result_id",
    "manifest_id",
    "version",
    "executed_at",
    "executor",
    "verdict",
    "cases"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^SMOKE-[0-9]{4}-[0-9]{4}$",
      "description": "冒烟测试结果唯一标识"
    },
    "manifest_id": {
      "type": "string",
      "description": "关联的提测包清单 ID"
    },
    "version": {
      "type": "string",
      "description": "测试版本"
    },
    "environment": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["dev", "test", "staging"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "deployed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor": {
      "type": "string",
      "description": "执行者 Agent ID"
    },
    "duration_seconds": {
      "type": "integer",
      "description": "执行耗时（秒）"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "blocked"],
      "description": "总体判定"
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": {
          "type": "integer",
          "description": "总用例数"
        },
        "passed": {
          "type": "integer",
          "description": "通过数"
        },
        "failed": {
          "type": "integer",
          "description": "失败数"
        },
        "skipped": {
          "type": "integer",
          "description": "跳过数"
        },
        "blocked": {
          "type": "integer",
          "description": "阻塞数"
        },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "通过率"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "name", "result"],
        "properties": {
          "case_id": {
            "type": "string",
            "description": "用例 ID"
          },
          "name": {
            "type": "string",
            "description": "用例名称"
          },
          "module": {
            "type": "string",
            "description": "所属模块"
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "skip", "blocked"]
          },
          "duration_ms": {
            "type": "integer"
          },
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "stack": { "type": "string" },
              "screenshot": { "type": "string" }
            }
          },
          "bug_id": {
            "type": "string",
            "description": "关联的缺陷 ID (如果失败)"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "issue", "severity"],
        "properties": {
          "case_id": { "type": "string" },
          "issue": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1"] },
          "bug_id": { "type": "string" }
        }
      },
      "description": "阻塞问题列表"
    },
    "recommendation": {
      "type": "string",
      "enum": ["proceed_to_system_test", "reject_and_return", "proceed_with_risk"],
      "description": "建议操作"
    },
    "notes": {
      "type": "string",
      "description": "备注说明"
    }
  }
}
