{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devops-config/v1/schema.json",
  "title": "DevOps Configuration Schema",
  "description": "测试环境管理员输入配置验证规范",
  "type": "object",
  "required": ["version", "project", "git", "server", "deploy"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "配置版本"
    },
    "config_id": {
      "type": "string",
      "pattern": "^DEVOPS-\\d{4}-\\d{4}$",
      "description": "配置ID"
    },
    "project": {
      "type": "object",
      "required": ["name", "environment"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "项目名称"
        },
        "version": {
          "type": "string",
          "description": "部署版本"
        },
        "environment": {
          "type": "string",
          "enum": ["test", "staging", "prod"],
          "description": "环境标识"
        }
      }
    },
    "git": {
      "type": "object",
      "required": ["backend"],
      "properties": {
        "backend": {
          "$ref": "#/$defs/gitRepo"
        },
        "frontend": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string" },
            "branch": { "type": "string" },
            "deploy_key": { "type": "string" }
          }
        },
        "clone_options": {
          "type": "object",
          "properties": {
            "depth": { "type": "integer", "minimum": 0 },
            "submodules": { "type": "boolean" }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "$ref": "#/$defs/serverConfig"
        },
        "jump_host": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": "integer" },
            "user": { "type": "string" },
            "key_path": { "type": "string" }
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "min_disk_gb": { "type": "integer" },
            "min_memory_gb": { "type": "integer" },
            "os": { "type": "string" },
            "os_version": { "type": "string" }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "primary": {
          "$ref": "#/$defs/databaseConfig"
        },
        "redis": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": "integer" },
            "password_ref": { "type": "string" },
            "db": { "type": "integer" }
          }
        },
        "migration": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "enum": ["golang-migrate", "knex", "alembic", "rails", "raw_sql"]
            },
            "path": { "type": "string" },
            "auto_migrate": { "type": "boolean" }
          }
        },
        "seed": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "files": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "app": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "auth": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "external": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "database": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "deploy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["docker_compose", "docker", "binary", "pm2", "kubernetes"]
        },
        "docker_compose": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "project_name": { "type": "string" },
            "pull_before_up": { "type": "boolean" },
            "build_before_up": { "type": "boolean" }
          }
        },
        "docker": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "container_name": { "type": "string" },
            "ports": {
              "type": "array",
              "items": { "type": "string" }
            },
            "volumes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "networks": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "binary": {
          "type": "object",
          "properties": {
            "build_command": { "type": "string" },
            "start_command": { "type": "string" },
            "process_manager": {
              "type": "string",
              "enum": ["systemd", "supervisor", "none"]
            }
          }
        },
        "pm2": {
          "type": "object",
          "properties": {
            "config_file": { "type": "string" },
            "env": { "type": "string" }
          }
        },
        "hooks": {
          "type": "object",
          "properties": {
            "pre_deploy": {
              "type": "array",
              "items": { "type": "string" }
            },
            "post_deploy": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "rollback": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "keep_versions": { "type": "integer" },
            "auto_rollback_on_failure": { "type": "boolean" }
          }
        }
      }
    },
    "health_check": {
      "type": "object",
      "properties": {
        "wait_for_ready": {
          "type": "object",
          "properties": {
            "timeout": { "type": "integer" },
            "interval": { "type": "integer" }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/healthCheckService"
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "files": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "rotation": {
          "type": "object",
          "properties": {
            "max_size": { "type": "string" },
            "max_files": { "type": "integer" },
            "compress": { "type": "boolean" }
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "webhook": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "events": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["env", "vault", "aws-secrets", "file"]
        },
        "vault": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "token_ref": { "type": "string" },
            "namespace": { "type": "string" },
            "path_prefix": { "type": "string" }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "last_updated": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "gitRepo": {
      "type": "object",
      "required": ["url", "branch"],
      "properties": {
        "url": {
          "type": "string",
          "description": "Git 仓库地址 (SSH 或 HTTPS)"
        },
        "branch": {
          "type": "string",
          "description": "分支名"
        },
        "tag": {
          "type": "string",
          "description": "版本标签"
        },
        "deploy_key": {
          "type": "string",
          "description": "部署密钥路径"
        },
        "token_ref": {
          "type": "string",
          "description": "Token 引用"
        }
      }
    },
    "serverConfig": {
      "type": "object",
      "required": ["host", "user", "auth", "work_dir"],
      "properties": {
        "host": {
          "type": "string",
          "description": "服务器地址"
        },
        "port": {
          "type": "integer",
          "default": 22,
          "description": "SSH 端口"
        },
        "user": {
          "type": "string",
          "description": "SSH 用户名"
        },
        "auth": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["key", "password"]
            },
            "key_path": {
              "type": "string",
              "description": "私钥路径"
            },
            "passphrase_ref": {
              "type": "string",
              "description": "密钥密码引用"
            },
            "password_ref": {
              "type": "string",
              "description": "密码引用"
            }
          }
        },
        "work_dir": {
          "type": "string",
          "description": "工作目录"
        },
        "backup_dir": {
          "type": "string",
          "description": "备份目录"
        }
      }
    },
    "databaseConfig": {
      "type": "object",
      "required": ["type", "host", "port", "name", "user"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["postgres", "mysql", "sqlite", "mongodb"]
        },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "name": { "type": "string" },
        "user": { "type": "string" },
        "password_ref": {
          "type": "string",
          "description": "密码引用 (vault: 或 env:)"
        },
        "ssl_mode": {
          "type": "string",
          "enum": ["disable", "require", "prefer"]
        },
        "pool_size": { "type": "integer" },
        "timeout": { "type": "integer" }
      }
    },
    "healthCheckService": {
      "type": "object",
      "required": ["name", "type", "critical"],
      "properties": {
        "name": {
          "type": "string",
          "description": "服务名称"
        },
        "type": {
          "type": "string",
          "enum": ["http", "tcp", "command"]
        },
        "url": {
          "type": "string",
          "description": "HTTP 检查 URL"
        },
        "host": {
          "type": "string",
          "description": "TCP 检查主机"
        },
        "port": {
          "type": "integer",
          "description": "TCP 检查端口"
        },
        "command": {
          "type": "string",
          "description": "命令检查"
        },
        "expected_status": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "预期 HTTP 状态码"
        },
        "expected_body_contains": {
          "type": "string",
          "description": "预期响应体包含"
        },
        "timeout": {
          "type": "integer",
          "description": "超时时间(秒)"
        },
        "critical": {
          "type": "boolean",
          "description": "是否为关键服务"
        }
      }
    }
  }
}
