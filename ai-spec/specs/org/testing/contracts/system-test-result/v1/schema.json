{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-constitution.dev/schemas/testing/system-test-result/v1",
  "title": "System Test Result Contract",
  "description": "系统测试结果契约 - 记录完整系统测试执行结果",
  "type": "object",
  "required": [
    "result_id",
    "manifest_id",
    "version",
    "test_cycle",
    "started_at",
    "executor",
    "modules"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^SYSTEST-[0-9]{4}-[0-9]{4}$",
      "description": "系统测试结果唯一标识"
    },
    "manifest_id": {
      "type": "string",
      "description": "关联的提测包清单 ID"
    },
    "version": {
      "type": "string",
      "description": "测试版本"
    },
    "test_cycle": {
      "type": "integer",
      "minimum": 1,
      "description": "测试轮次"
    },
    "environment": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "config_snapshot": { "type": "string" }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor": {
      "type": "string",
      "description": "执行者 Agent ID"
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "blocked": { "type": "integer" },
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "by_priority": {
      "type": "object",
      "properties": {
        "P0": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "failed": { "type": "integer" }
          }
        },
        "P1": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "failed": { "type": "integer" }
          }
        },
        "P2": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "failed": { "type": "integer" }
          }
        }
      }
    },
    "by_type": {
      "type": "object",
      "properties": {
        "functional": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "pass_rate": { "type": "number" }
          }
        },
        "integration": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "pass_rate": { "type": "number" }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "pass_rate": { "type": "number" }
          }
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "pass_rate": { "type": "number" }
          }
        },
        "edge_case": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passed": { "type": "integer" },
            "pass_rate": { "type": "number" }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "name", "cases"],
        "properties": {
          "module_id": { "type": "string" },
          "name": { "type": "string" },
          "total": { "type": "integer" },
          "passed": { "type": "integer" },
          "failed": { "type": "integer" },
          "pass_rate": { "type": "number" },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["case_id", "name", "result"],
              "properties": {
                "case_id": { "type": "string" },
                "name": { "type": "string" },
                "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "type": { "type": "string" },
                "result": { "type": "string", "enum": ["pass", "fail", "skip", "blocked"] },
                "duration_ms": { "type": "integer" },
                "error": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "stack": { "type": "string" }
                  }
                },
                "bug_id": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "bugs_found": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bug_id", "severity", "status"],
        "properties": {
          "bug_id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "status": { "type": "string" },
          "module": { "type": "string" }
        }
      },
      "description": "本轮发现的缺陷列表"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "requirement_coverage": { "type": "number", "minimum": 0, "maximum": 100 },
        "code_coverage": { "type": "number", "minimum": 0, "maximum": 100 },
        "path_coverage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "status": {
      "type": "string",
      "enum": ["in_progress", "completed", "paused", "blocked"],
      "description": "测试状态"
    }
  }
}
