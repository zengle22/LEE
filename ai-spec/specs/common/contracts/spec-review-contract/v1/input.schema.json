{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/spec-review-contract/v1/input.schema.json",
    "title": "Spec Review Input Schema",
    "description": "Input schema for the Spec Review Agent",
    "type": "object",
    "required": [
        "spec_text",
        "filename"
    ],
    "properties": {
        "filename": {
            "type": "string",
            "description": "Name of the spec file being reviewed (e.g., 'keyword_analysis.yaml')"
        },
        "spec_text": {
            "type": "string",
            "description": "Raw YAML/JSON content of the spec file"
        },
        "mode": {
            "type": "string",
            "enum": [
                "full",
                "lint_only"
            ],
            "default": "full",
            "description": "Review mode: 'full' for complete review, 'lint_only' for syntax checks only"
        },
        "repo_conventions": {
            "type": "object",
            "description": "Repository-specific conventions to enforce",
            "properties": {
                "id_prefix_rules": {
                    "type": "object",
                    "description": "Rules for ID prefixes by kind",
                    "properties": {
                        "skill": {
                            "type": "string",
                            "default": "skill."
                        },
                        "agent": {
                            "type": "string",
                            "default": "agent."
                        },
                        "workflow": {
                            "type": "string",
                            "default": "workflow."
                        }
                    }
                },
                "required_fields": {
                    "type": "object",
                    "description": "Additional required fields by kind",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "forbidden_patterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Regex patterns that should not appear in specs"
                }
            }
        }
    }
}