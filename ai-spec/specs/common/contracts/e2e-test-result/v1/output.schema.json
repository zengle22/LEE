{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-constitution.dev/contracts/e2e-test-result/v1/output.schema.json",
  "title": "E2E Test Result Contract",
  "description": "E2E 测试结果契约 - 定义 E2E 测试执行后的输出格式",
  "type": "object",
  "required": ["status", "report_path", "summary"],
  "properties": {
    "status": {
      "type": "string",
      "description": "测试执行状态",
      "enum": ["PASS", "CONDITIONAL_PASS", "FAIL", "ERROR"],
      "examples": ["PASS", "FAIL"]
    },
    "exit_code": {
      "type": "integer",
      "description": "进程退出码（0=成功，非0=失败）",
      "minimum": 0,
      "examples": [0, 1]
    },
    "report_path": {
      "type": "string",
      "description": "HTML 报告路径",
      "examples": ["output/playwright-report/index.html"]
    },
    "json_report_path": {
      "type": "string",
      "description": "JSON 报告路径（机器可读）",
      "examples": ["output/e2e-report.json"]
    },
    "evidence_dir": {
      "type": "string",
      "description": "证据目录（screenshots/videos/traces）",
      "examples": ["output/test-results"]
    },
    "summary": {
      "type": "object",
      "description": "测试摘要",
      "required": ["total", "passed", "failed", "skipped", "duration_ms", "pass_rate"],
      "properties": {
        "total": {
          "type": "integer",
          "description": "总用例数",
          "minimum": 0,
          "examples": [12]
        },
        "passed": {
          "type": "integer",
          "description": "通过数",
          "minimum": 0,
          "examples": [11]
        },
        "failed": {
          "type": "integer",
          "description": "失败数",
          "minimum": 0,
          "examples": [1]
        },
        "skipped": {
          "type": "integer",
          "description": "跳过数",
          "minimum": 0,
          "examples": [0]
        },
        "flaky": {
          "type": "integer",
          "description": "不稳定用例数（重试后通过）",
          "minimum": 0,
          "examples": [1]
        },
        "duration_ms": {
          "type": "integer",
          "description": "总耗时（毫秒）",
          "minimum": 0,
          "examples": [42150]
        },
        "pass_rate": {
          "type": "number",
          "description": "通过率（0-100）",
          "minimum": 0,
          "maximum": 100,
          "examples": [91.67]
        },
        "p0_pass_rate": {
          "type": "number",
          "description": "P0 用例通过率（0-100）",
          "minimum": 0,
          "maximum": 100,
          "examples": [100.0]
        },
        "p1_pass_rate": {
          "type": "number",
          "description": "P1 用例通过率（0-100）",
          "minimum": 0,
          "maximum": 100,
          "examples": [90.0]
        }
      }
    },
    "failed_tests": {
      "type": "array",
      "description": "失败的测试用例列表",
      "items": {
        "type": "object",
        "required": ["test_id", "title", "error"],
        "properties": {
          "test_id": {
            "type": "string",
            "description": "测试 ID（文件路径:行号）",
            "examples": ["tests/login.spec.ts:15"]
          },
          "title": {
            "type": "string",
            "description": "测试标题",
            "examples": ["登录 - 错误密码应该显示提示"]
          },
          "priority": {
            "type": "string",
            "description": "优先级",
            "enum": ["P0", "P1", "P2", "P3"],
            "examples": ["P0"]
          },
          "error": {
            "type": "string",
            "description": "错误信息",
            "examples": ["Timeout 30000ms exceeded waiting for selector [data-testid=\"login-error\"]"]
          },
          "screenshot": {
            "type": "string",
            "description": "失败截图路径",
            "examples": ["output/test-results/login-错误密码-failed-1/test-failed-1.png"]
          },
          "video": {
            "type": "string",
            "description": "录屏路径",
            "examples": ["output/test-results/login-错误密码-failed-1/video.webm"]
          },
          "trace": {
            "type": "string",
            "description": "trace 文件路径",
            "examples": ["output/test-results/login-错误密码-failed-1/trace.zip"]
          }
        }
      }
    },
    "flaky_tests": {
      "type": "array",
      "description": "不稳定的测试用例（重试后通过）",
      "items": {
        "type": "object",
        "required": ["test_id", "title", "failures", "retries"],
        "properties": {
          "test_id": {
            "type": "string",
            "examples": ["tests/login.spec.ts:25"]
          },
          "title": {
            "type": "string",
            "examples": ["登录 - 键盘操作"]
          },
          "failures": {
            "type": "integer",
            "description": "失败次数",
            "minimum": 1,
            "examples": [1]
          },
          "retries": {
            "type": "integer",
            "description": "重试次数",
            "minimum": 1,
            "examples": [2]
          },
          "recommendation": {
            "type": "string",
            "description": "修复建议",
            "examples": ["可能存在时序问题，建议增加显式等待"]
          }
        }
      }
    },
    "accessibility_violations": {
      "type": "array",
      "description": "可访问性违规列表",
      "items": {
        "type": "object",
        "required": ["page", "rule", "impact"],
        "properties": {
          "page": {
            "type": "string",
            "description": "页面路径",
            "examples": ["/home"]
          },
          "rule": {
            "type": "string",
            "description": "违规规则 ID",
            "examples": ["color-contrast"]
          },
          "impact": {
            "type": "string",
            "description": "影响程度",
            "enum": ["critical", "serious", "moderate", "minor"],
            "examples": ["serious"]
          },
          "description": {
            "type": "string",
            "description": "违规描述",
            "examples": ["Elements must have sufficient color contrast"]
          },
          "nodes": {
            "type": "array",
            "description": "违规元素",
            "items": {
              "type": "string"
            },
            "examples": [["#main-button", ".card-title"]]
          }
        }
      }
    }
  },
  "examples": [
    {
      "status": "PASS",
      "exit_code": 0,
      "report_path": "output/playwright-report/index.html",
      "json_report_path": "output/e2e-report.json",
      "evidence_dir": "output/test-results",
      "summary": {
        "total": 12,
        "passed": 12,
        "failed": 0,
        "skipped": 0,
        "flaky": 0,
        "duration_ms": 42150,
        "pass_rate": 100.0,
        "p0_pass_rate": 100.0,
        "p1_pass_rate": 100.0
      },
      "failed_tests": [],
      "flaky_tests": [],
      "accessibility_violations": []
    },
    {
      "status": "FAIL",
      "exit_code": 1,
      "report_path": "output/playwright-report/index.html",
      "json_report_path": "output/e2e-report.json",
      "evidence_dir": "output/test-results",
      "summary": {
        "total": 12,
        "passed": 11,
        "failed": 1,
        "skipped": 0,
        "flaky": 1,
        "duration_ms": 45230,
        "pass_rate": 91.67,
        "p0_pass_rate": 100.0,
        "p1_pass_rate": 75.0
      },
      "failed_tests": [
        {
          "test_id": "tests/login.spec.ts:15",
          "title": "登录 - 错误密码应该显示提示",
          "priority": "P1",
          "error": "Timeout 30000ms exceeded waiting for selector [data-testid=\"login-error\"]",
          "screenshot": "output/test-results/login-错误密码-failed-1/test-failed-1.png",
          "video": "output/test-results/login-错误密码-failed-1/video.webm",
          "trace": "output/test-results/login-错误密码-failed-1/trace.zip"
        }
      ],
      "flaky_tests": [
        {
          "test_id": "tests/login.spec.ts:25",
          "title": "登录 - 键盘操作",
          "failures": 1,
          "retries": 2,
          "recommendation": "可能存在时序问题，建议增加显式等待"
        }
      ],
      "accessibility_violations": []
    }
  ]
}
