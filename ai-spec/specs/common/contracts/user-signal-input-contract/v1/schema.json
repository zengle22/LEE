{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-spec.example.com/contracts/user-signal-input-contract/v1/schema.json",
  "title": "User Signal Input Contract Schema",
  "description": "Schema for raw keyword data extracted from search results, used as input for user signal analysis",
  "type": "object",
  "required": ["contract_type", "contract_version", "metadata", "keywords_raw"],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "user-signal-input"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["analysis_id", "source_domain", "generated_at", "data_source"],
      "properties": {
        "analysis_id": {
          "type": "string",
          "pattern": "^USI-\\d{8}-\\d{3}$"
        },
        "source_domain": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "data_source": {
          "type": "string"
        }
      }
    },
    "keywords_raw": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/KeywordRaw"
      },
      "minItems": 1
    },
    "search_context": {
      "$ref": "#/$defs/SearchContext"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "KeywordRaw": {
      "type": "object",
      "required": ["keyword", "search_volume", "intent_signals", "source_type"],
      "properties": {
        "keyword": {
          "type": "string",
          "minLength": 1
        },
        "search_volume": {
          "$ref": "#/$defs/SearchVolume"
        },
        "intent_signals": {
          "$ref": "#/$defs/IntentSignals"
        },
        "longtail_variants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_queries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        }
      }
    },
    "SearchVolume": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["very_high", "high", "medium", "low", "very_low"]
        },
        "estimated_monthly": {
          "type": "string"
        },
        "trend": {
          "type": "string",
          "enum": ["rising", "stable", "declining", "seasonal"]
        }
      }
    },
    "IntentSignals": {
      "type": "object",
      "properties": {
        "raw_intent_type": {
          "type": "string"
        },
        "question_markers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "action_markers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "comparison_markers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SearchContext": {
      "type": "object",
      "properties": {
        "market": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "device_hints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "time_sensitivity": {
          "type": "boolean"
        },
        "seasonality": {
          "type": "string"
        }
      }
    },
    "SourceType": {
      "type": "string",
      "enum": ["autocomplete", "related_search", "people_also_ask", "longtail_expansion", "competitor_analysis"]
    }
  }
}
