{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/decision-document-contract/v1/schema.json",
    "title": "Decision Document Contract Schema",
    "description": "Contract for ambiguity decision documentation",
    "type": "object",
    "required": [
        "contract_type",
        "contract_version",
        "metadata",
        "ambiguities"
    ],
    "properties": {
        "contract_type": {
            "type": "string",
            "const": "decision-document"
        },
        "contract_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "metadata": {
            "type": "object",
            "required": [
                "contract_id",
                "generated_at",
                "status"
            ],
            "properties": {
                "contract_id": {
                    "type": "string",
                    "pattern": "^DD-\\d{8}-\\d{3}$"
                },
                "requirement_title": {
                    "type": "string"
                },
                "generated_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "PENDING_DECISION",
                        "COMPLETED",
                        "PROCESSING"
                    ]
                },
                "ambiguity_count": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "ambiguities": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "index",
                    "description",
                    "type",
                    "interpretations"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^AMB-\\d{3}$"
                    },
                    "index": {
                        "type": "integer"
                    },
                    "description": {
                        "type": "string"
                    },
                    "description_short": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "scope",
                            "requirement",
                            "technical",
                            "priority",
                            "constraint"
                        ]
                    },
                    "type_display": {
                        "type": "string"
                    },
                    "discovery_context": {
                        "type": "string"
                    },
                    "detailed_description": {
                        "type": "string"
                    },
                    "context": {
                        "type": "string"
                    },
                    "impact_scope": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "interpretations": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                            "type": "object",
                            "required": [
                                "option_letter",
                                "description"
                            ],
                            "properties": {
                                "option_letter": {
                                    "type": "string",
                                    "pattern": "^[A-Z]$"
                                },
                                "description": {
                                    "type": "string"
                                },
                                "cost_display": {
                                    "type": "string"
                                },
                                "risk_display": {
                                    "type": "string"
                                },
                                "recommendation_stars": {
                                    "type": "string"
                                },
                                "pros": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "cons": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "implementation_notes": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "suggested_decision": {
                        "type": "string"
                    },
                    "suggested_option": {
                        "type": "string"
                    },
                    "status_display": {
                        "type": "string"
                    },
                    "has_option_c": {
                        "type": "boolean"
                    },
                    "has_option_d": {
                        "type": "boolean"
                    },
                    "decision": {
                        "type": "object",
                        "properties": {
                            "chosen_option": {
                                "type": "string"
                            },
                            "decided_by": {
                                "type": "string"
                            },
                            "decided_at": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "rationale": {
                                "type": "string"
                            },
                            "follow_up_actions": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "confirmation": {
            "type": "object",
            "properties": {
                "all_decided": {
                    "type": "boolean"
                },
                "confirmed_by": {
                    "type": "string"
                },
                "confirmed_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "overall_comments": {
                    "type": "string"
                }
            }
        },
        "change_log": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "version": {
                        "type": "string"
                    },
                    "date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "changes": {
                        "type": "string"
                    },
                    "author": {
                        "type": "string"
                    }
                }
            }
        }
    }
}