{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-spec.example.com/contracts/_template/v1/schema.json",
  "title": "Contract Template Schema",
  "description": "Standard template for AI-Spec contract schemas. All contracts should follow this structure.",
  "type": "object",
  "required": ["contract_type", "contract_version", "metadata"],
  "properties": {
    "contract_type": {
      "type": "string",
      "description": "Contract type identifier (e.g., 'fact-collection', 'business-opportunity-output')"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the contract (e.g., '1.0.0')"
    },
    "metadata": {
      "type": "object",
      "description": "Contract metadata including IDs and timestamps",
      "required": ["generated_at"],
      "properties": {
        "analysis_id": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}-\\d{8}-\\d{3}(-\\d{2})?$",
          "description": "Analysis ID in format: XX-YYYYMMDD-XXX (e.g., FC-20260104-001)"
        },
        "source_contract": {
          "type": "string",
          "description": "Reference to the source/input contract ID"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Generation timestamp in ISO 8601 format"
        },
        "keyword": {
          "type": "string",
          "description": "Core keyword or domain being analyzed"
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Priority": {
      "type": "string",
      "enum": ["critical", "important", "nice_to_have"],
      "description": "Priority level for items"
    },
    "ConfidenceLevel": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Confidence level for assumptions and conclusions"
    },
    "RiskLevel": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Risk level classification"
    },
    "Trend": {
      "type": "string",
      "enum": ["up", "flat", "down", "unknown", "rising", "stable", "declining", "seasonal"],
      "description": "Trend direction indicator"
    },
    "Source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["search_result", "app_store", "news_article", "official_site", "review_site", "forum", "report", "social_media", "investor_report"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "reliability": {
          "type": "string",
          "enum": ["high", "medium", "low", "unverified"]
        }
      }
    },
    "PendingConfirmation": {
      "type": "object",
      "required": ["id", "question", "priority"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PC-\\d{3}$",
          "description": "Pending confirmation ID (e.g., PC-001)"
        },
        "category": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "impact": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        }
      }
    }
  }
}
