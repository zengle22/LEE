{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ai-spec.example.com/contracts/frozen-dev-package-contract/v1/schema.json",
    "title": "Frozen Development Freeze Package Contract Schema",
    "description": "Combined package for R&D production cycle",
    "type": "object",
    "required": [
        "contract_type",
        "contract_version",
        "metadata",
        "package_content",
        "scheduling_validation"
    ],
    "properties": {
        "contract_type": {
            "type": "string",
            "const": "frozen-dev-package"
        },
        "contract_version": {
            "type": "string"
        },
        "metadata": {
            "type": "object",
            "required": [
                "package_id",
                "created_at",
                "total_confidence_score"
            ],
            "properties": {
                "package_id": {
                    "type": "string",
                    "pattern": "^FPKG-\\d{8}-\\d{3}$"
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "total_confidence_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                }
            }
        },
        "package_content": {
            "type": "object",
            "required": [
                "prd_ref",
                "tech_ref",
                "ui_ref"
            ],
            "properties": {
                "prd_ref": {
                    "type": "string",
                    "description": "Link to frozen-detailed-prd"
                },
                "tech_ref": {
                    "type": "string",
                    "description": "Link to frozen-technical-architecture"
                },
                "ui_ref": {
                    "type": "string",
                    "description": "Link to frozen-ui-prototype"
                }
            }
        },
        "scheduling_validation": {
            "type": "object",
            "required": [
                "q1_non_goals",
                "q2_simplification",
                "q3_uncertainties",
                "q4_ui_priority",
                "q5_cut_sequence"
            ],
            "properties": {
                "q1_non_goals": {
                    "type": "string",
                    "description": "这个需求不做什么？"
                },
                "q2_simplification": {
                    "type": "string",
                    "description": "哪些地方允许先简化 / 降级？"
                },
                "q3_uncertainties": {
                    "type": "string",
                    "description": "技术上最不确定的 1～2 个点是什么？"
                },
                "q4_ui_priority": {
                    "type": "string",
                    "description": "哪些 UI 是必须现在定，哪些可以后补？"
                },
                "q5_cut_sequence": {
                    "type": "string",
                    "description": "如果延期，最先砍哪一块？"
                }
            }
        }
    }
}