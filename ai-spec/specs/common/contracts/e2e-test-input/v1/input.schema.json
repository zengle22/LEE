{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-constitution.dev/contracts/e2e-test-input/v1/input.schema.json",
  "title": "E2E Test Input Contract",
  "description": "E2E 测试输入契约 - 定义执行 E2E 测试所需的输入参数",
  "type": "object",
  "required": ["test_suite_path", "base_url"],
  "properties": {
    "test_suite_path": {
      "type": "string",
      "description": "测试套件路径（相对于项目根目录）",
      "examples": [
        "test-cases/e2e/chrome/",
        "test-cases/e2e/smoke/"
      ],
      "minLength": 1
    },
    "base_url": {
      "type": "string",
      "description": "被测应用的 URL",
      "format": "uri",
      "examples": [
        "https://test.example.com",
        "http://localhost:3000"
      ]
    },
    "browser": {
      "type": "string",
      "description": "浏览器类型",
      "enum": ["chromium", "firefox", "webkit"],
      "default": "chromium"
    },
    "workers": {
      "type": "integer",
      "description": "并行 worker 数量",
      "minimum": 1,
      "maximum": 16,
      "default": 4
    },
    "retries": {
      "type": "integer",
      "description": "失败重试次数",
      "minimum": 0,
      "maximum": 5,
      "default": 2
    },
    "timeout": {
      "type": "integer",
      "description": "单个测试超时时间（毫秒）",
      "minimum": 5000,
      "maximum": 120000,
      "default": 30000
    },
    "headed": {
      "type": "boolean",
      "description": "是否使用有头模式（调试用）",
      "default": false
    },
    "env_vars": {
      "type": "object",
      "description": "额外的环境变量",
      "additionalProperties": {
        "type": "string"
      },
      "examples": [{
        "AUTH_TOKEN": "test_token_123",
        "API_BASE_URL": "https://api.test.example.com"
      }]
    },
    "filter": {
      "type": "object",
      "description": "测试过滤条件",
      "properties": {
        "priority": {
          "type": "array",
          "description": "只执行指定优先级的测试",
          "items": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "examples": [["P0", "P1"]]
        },
        "tags": {
          "type": "array",
          "description": "只执行包含指定标签的测试",
          "items": {
            "type": "string"
          },
          "examples": [["@smoke", "@critical"]]
        },
        "grep": {
          "type": "string",
          "description": "只执行匹配正则的测试",
          "examples": ["登录", "^首页"]
        }
      }
    }
  },
  "examples": [
    {
      "test_suite_path": "test-cases/e2e/chrome/",
      "base_url": "https://test.example.com",
      "browser": "chromium",
      "workers": 4,
      "retries": 2,
      "timeout": 30000,
      "headed": false,
      "env_vars": {
        "AUTH_TOKEN": "test_token_123"
      }
    },
    {
      "test_suite_path": "test-cases/e2e/smoke/",
      "base_url": "http://localhost:3000",
      "browser": "chromium",
      "filter": {
        "priority": ["P0"],
        "tags": ["@smoke"]
      }
    }
  ]
}
