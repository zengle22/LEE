{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-page-contract/v1/schema.json",
  "title": "UI Page Contract",
  "description": "页面契约规范 - 定义页面应该长什么样、有哪些状态、有哪些交互、哪些校验",
  "type": "object",
  "required": ["id", "route", "states"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^page\\.[a-z_]+$",
      "description": "页面唯一标识符，格式: page.{name}"
    },
    "route": {
      "type": "string",
      "description": "路由路径，支持参数如 /user/:id"
    },
    "title": {
      "type": "string",
      "description": "页面标题"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["guest", "user", "admin", "super_admin"]
      },
      "description": "可访问该页面的角色列表"
    },
    "figma": {
      "type": "string",
      "description": "Figma 设计稿链接"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/PageState"
      },
      "description": "页面状态列表，必须包含 default/loading/empty/error"
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Interaction"
      },
      "description": "页面交互定义"
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ValidationRule"
      },
      "description": "表单校验规则"
    },
    "tracking": {
      "$ref": "#/definitions/Tracking",
      "description": "埋点配置"
    },
    "a11y": {
      "$ref": "#/definitions/A11yConfig",
      "description": "可访问性配置"
    },
    "seo": {
      "$ref": "#/definitions/SeoConfig",
      "description": "SEO 配置"
    }
  },
  "definitions": {
    "PageState": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["default", "loading", "empty", "error", "success", "partial"],
          "description": "状态名称"
        },
        "pattern": {
          "type": "string",
          "enum": ["skeleton", "spinner", "placeholder", "custom"],
          "description": "加载态展示模式"
        },
        "messageKey": {
          "type": "string",
          "description": "空状态或错误状态的文案 key"
        },
        "errorCodes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "该状态对应的错误码列表"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentRef"
          },
          "description": "该状态下的组件列表"
        }
      }
    },
    "ComponentRef": {
      "type": "object",
      "required": ["ref", "id"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^component\\.[a-z_]+$",
          "description": "组件契约引用"
        },
        "id": {
          "type": "string",
          "description": "组件实例 ID"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "是否必须存在"
        },
        "props": {
          "type": "object",
          "description": "组件属性配置"
        },
        "slot": {
          "type": "string",
          "description": "组件插槽位置"
        }
      }
    },
    "Interaction": {
      "type": "object",
      "required": ["id", "trigger"],
      "properties": {
        "id": {
          "type": "string",
          "description": "交互唯一标识"
        },
        "trigger": {
          "type": "string",
          "description": "触发条件，如 click(button_id)"
        },
        "api": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]
            },
            "endpoint": {
              "type": "string"
            },
            "contractRef": {
              "type": "string",
              "description": "API 契约引用"
            }
          }
        },
        "navigation": {
          "type": "object",
          "properties": {
            "to": { "type": "string" },
            "params": { "type": "object" }
          }
        },
        "success": {
          "type": "object",
          "properties": {
            "toastKey": { "type": "string" },
            "redirect": { "type": "string" },
            "updateState": { "type": "string" }
          }
        },
        "failure": {
          "type": "object",
          "properties": {
            "showInlineError": { "type": "boolean" },
            "toastKey": { "type": "string" },
            "fallbackState": { "type": "string" }
          }
        }
      }
    },
    "ValidationRule": {
      "type": "object",
      "required": ["field", "rules"],
      "properties": {
        "field": {
          "type": "string",
          "description": "字段名"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["required", "minLength", "maxLength", "min", "max", "pattern", "email", "phone", "custom"]
              },
              "value": {},
              "messageKey": { "type": "string" }
            }
          }
        }
      }
    },
    "Tracking": {
      "type": "object",
      "properties": {
        "exposure": {
          "type": "array",
          "items": { "type": "string" },
          "description": "页面曝光事件列表"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event", "trigger"],
            "properties": {
              "event": { "type": "string" },
              "trigger": { "type": "string" },
              "params": { "type": "object" }
            }
          }
        }
      }
    },
    "A11yConfig": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "default": true
        },
        "focusOrder": {
          "type": "array",
          "items": { "type": "string" },
          "description": "焦点顺序"
        },
        "landmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "skipLinks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SeoConfig": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canonical": { "type": "string" },
        "noindex": { "type": "boolean" }
      }
    }
  }
}
