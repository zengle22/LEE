{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-spec.example.com/contracts/trend-research-contract/v1/schema.json",
  "title": "Trend Research Contract Schema",
  "description": "Schema for trend research output - Porter's Five Forces, Top 3 products analysis, market data",
  "type": "object",
  "required": ["contract_type", "contract_version", "metadata", "segments_research", "summary"],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "trend-research-output"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["research_id", "source_contract", "generated_at", "keyword_count", "segment_count"],
      "properties": {
        "research_id": {
          "type": "string",
          "pattern": "^TR-\\d{8}-\\d{3}(-\\d{2})?$"
        },
        "source_contract": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "keyword_count": {
          "type": "integer",
          "minimum": 1
        },
        "segment_count": {
          "type": "integer",
          "minimum": 1
        },
        "is_split_report": {
          "type": "boolean"
        },
        "related_reports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_products_found": {
          "type": "integer",
          "minimum": 0
        },
        "total_sources": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "segments_research": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SegmentResearch"
      },
      "minItems": 1
    },
    "summary": {
      "$ref": "#/$defs/ResearchSummary"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SegmentResearch": {
      "type": "object",
      "required": ["segment_name", "research_status"],
      "properties": {
        "segment_name": { "type": "string" },
        "segment_definition": { "type": "string" },
        "research_status": {
          "type": "string",
          "enum": ["completed", "partial", "failed", "skipped"]
        },
        "background": {
          "type": "object",
          "properties": {
            "definition": { "type": "string" },
            "origin": { "type": "string" },
            "popularity_reason": { "type": "string" },
            "related_events": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "porter_five_forces": {
          "$ref": "#/$defs/PorterFiveForces"
        },
        "top_products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopProduct"
          },
          "maxItems": 3
        },
        "market_data": {
          "type": "object",
          "properties": {
            "market_size_info": {
              "type": "array",
              "items": { "type": "string" }
            },
            "growth_info": {
              "type": "array",
              "items": { "type": "string" }
            },
            "key_players": {
              "type": "array",
              "items": { "type": "string" }
            },
            "investment_news": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        }
      }
    },
    "PorterFiveForces": {
      "type": "object",
      "properties": {
        "supplier_power": {
          "type": "object",
          "properties": {
            "key_suppliers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "supplier_concentration": { "type": "string" },
            "switching_cost": { "type": "string" },
            "supplier_differentiation": { "type": "string" },
            "dependency_level": { "type": "string" },
            "raw_data": {
              "type": "array",
              "items": { "$ref": "#/$defs/RawDataItem" }
            }
          }
        },
        "buyer_power": {
          "type": "object",
          "properties": {
            "buyer_concentration": { "type": "string" },
            "purchase_volume": { "type": "string" },
            "switching_cost": { "type": "string" },
            "price_sensitivity": { "type": "string" },
            "information_availability": { "type": "string" },
            "alternative_options": {
              "type": "array",
              "items": { "type": "string" }
            },
            "raw_data": {
              "type": "array",
              "items": { "$ref": "#/$defs/RawDataItem" }
            }
          }
        },
        "new_entrants_threat": {
          "type": "object",
          "properties": {
            "recent_entrants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "entry_date": { "type": "string" },
                  "funding": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "entry_barriers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "level": {
                    "type": "string",
                    "enum": ["high", "medium", "low"]
                  },
                  "description": { "type": "string" }
                }
              }
            },
            "capital_requirements": { "type": "string" },
            "technology_barriers": { "type": "string" },
            "regulatory_barriers": { "type": "string" },
            "brand_loyalty": { "type": "string" },
            "economies_of_scale": { "type": "string" },
            "raw_data": {
              "type": "array",
              "items": { "$ref": "#/$defs/RawDataItem" }
            }
          }
        },
        "substitutes_threat": {
          "type": "object",
          "properties": {
            "substitute_products": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "category": { "type": "string" },
                  "comparison": { "type": "string" }
                }
              }
            },
            "substitute_performance": { "type": "string" },
            "switching_tendency": { "type": "string" },
            "price_performance_ratio": { "type": "string" },
            "raw_data": {
              "type": "array",
              "items": { "$ref": "#/$defs/RawDataItem" }
            }
          }
        },
        "industry_rivalry": {
          "type": "object",
          "properties": {
            "competitor_count": { "type": "string" },
            "market_concentration": { "type": "string" },
            "market_growth_rate": { "type": "string" },
            "product_differentiation": { "type": "string" },
            "exit_barriers": { "type": "string" },
            "competitive_moves": {
              "type": "array",
              "items": { "type": "string" }
            },
            "price_competition": { "type": "string" },
            "raw_data": {
              "type": "array",
              "items": { "$ref": "#/$defs/RawDataItem" }
            }
          }
        }
      }
    },
    "TopProduct": {
      "type": "object",
      "required": ["rank", "name"],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "name": { "type": "string" },
        "market_share": { "type": "string" },
        "platform": {
          "type": "string",
          "enum": ["ios", "android", "both", "web", "desktop", "cross_platform"]
        },
        "basic_info": {
          "type": "object",
          "properties": {
            "developer": { "type": "string" },
            "store_url": {
              "type": "string",
              "format": "uri"
            },
            "official_url": {
              "type": "string",
              "format": "uri"
            },
            "rating": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "rating_count": { "type": "string" },
            "download_count": { "type": "string" },
            "founded_date": { "type": "string" },
            "headquarters": { "type": "string" }
          }
        },
        "user_profile": {
          "type": "object",
          "properties": {
            "demographics": { "type": "object" },
            "psychographics": { "type": "object" },
            "behavioral": { "type": "object" },
            "user_reviews_raw": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "features": {
          "type": "object",
          "properties": {
            "core_features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "category": { "type": "string" }
                }
              }
            },
            "unique_features": {
              "type": "array",
              "items": { "type": "object" }
            },
            "pricing": { "type": "object" },
            "recent_updates": {
              "type": "array",
              "items": { "type": "object" }
            },
            "roadmap": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "marketing": {
          "type": "object",
          "properties": {
            "positioning": { "type": "string" },
            "target_segment": { "type": "string" },
            "unique_selling_points": {
              "type": "array",
              "items": { "type": "string" }
            },
            "brand_message": { "type": "string" },
            "marketing_channels": {
              "type": "array",
              "items": { "type": "object" }
            },
            "social_presence": {
              "type": "array",
              "items": { "type": "object" }
            },
            "differentiation_vs_competitors": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/Source" }
        }
      }
    },
    "Source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["search_result", "app_store", "news_article", "official_site", "review_site", "forum", "report", "social_media", "investor_report"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": { "type": "string" },
        "snippet": { "type": "string" },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "reliability": {
          "type": "string",
          "enum": ["high", "medium", "low", "unverified"]
        }
      }
    },
    "RawDataItem": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "string" },
        "source": { "$ref": "#/$defs/Source" }
      }
    },
    "ResearchSummary": {
      "type": "object",
      "properties": {
        "segments_researched": {
          "type": "array",
          "items": { "type": "string" }
        },
        "segments_skipped": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_top_products": {
          "type": "integer",
          "minimum": 0
        },
        "porter_coverage": {
          "type": "object",
          "properties": {
            "supplier_power": { "$ref": "#/$defs/CoverageLevel" },
            "buyer_power": { "$ref": "#/$defs/CoverageLevel" },
            "new_entrants": { "$ref": "#/$defs/CoverageLevel" },
            "substitutes": { "$ref": "#/$defs/CoverageLevel" },
            "rivalry": { "$ref": "#/$defs/CoverageLevel" }
          }
        },
        "data_freshness": { "type": "string" },
        "coverage_notes": { "type": "string" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CoverageLevel": {
      "type": "string",
      "enum": ["full", "partial", "minimal", "none"]
    }
  }
}
